{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=gastronomico.db"
  },
  "Jwt": {
    "Issuer": "GastronomicoAPI",
    "Audience": "GastronomicoWeb",
    "AccessTokenHours": 12
  },
  "Cors": {
    "Origins": [ "http://localhost:5000", "https://localhost:7206" ]
  },
  "Billing": {
    "Provider": "none",
    "WebhookSecret": ""
  },
  "Printing": {
    "Enabled": false,
    "PrinterName": ""
  },
  "Plans": {
    "Starter": {
      "Currency": "ARS",
      "MonthlyPrice": "0",
      "TrialDays": "14",
      "MaxUsers": "3",
      "MaxProducts": "80",
      "MaxTables": "12"
    },
    "Pro": {
      "Currency": "ARS",
      "MonthlyPrice": "0",
      "TrialDays": "14",
      "MaxUsers": "10",
      "MaxProducts": "400",
      "MaxTables": "40"
    }
  }
}
