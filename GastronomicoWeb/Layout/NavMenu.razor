@using Microsoft.AspNetCore.Components.Authorization
@using RotiseriaWeb.Services
@inject SaaSStateService SaaSState
@implements IDisposable

<MudNavMenu Class="px-2 py-2" Color="Color.Primary" Bordered="false">
    <div class="px-3 py-3 mb-1 d-flex justify-space-between align-center" style="border-bottom: 1px solid var(--saas-border-subtle);">
        <div class="d-flex align-center gap-2" style="overflow: hidden;">
            <div style="width: 28px; height: 28px; min-width: 28px; border-radius: 6px; background: var(--saas-primary); display: flex; align-items: center; justify-content: center; color: var(--saas-primary-text);">
                <MudIcon Icon="@Icons.Material.Filled.Storefront" Size="Size.Small" />
            </div>
            <div style="overflow: hidden;">
                <MudText Typo="Typo.subtitle2" Class="font-weight-bold" Style="line-height: 1.2; text-overflow: ellipsis; overflow: hidden; white-space: nowrap;">
                    @(SaaSState.CurrentBusiness?.TradeName ?? "SaaS Gastronómico")
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-size: 0.7rem;">
                    Local Activo
                </MudText>
            </div>
        </div>
        <div>
            @if (SaaSState.IsTester)
            {
                <span class="saas-badge saas-badge-info" style="font-size: 0.65rem;">TESTER</span>
            }
            else if (SaaSState.IsPremium)
            {
                <span class="saas-badge saas-badge-warning" style="font-size: 0.65rem;">PREMIUM</span>
            }
            else
            {
                <span class="saas-badge saas-badge-neutral" style="font-size: 0.65rem;">BÁSICO</span>
            }
        </div>
    </div>

    <MudNavGroup Title="Punto de Venta" Icon="@Icons.Material.Filled.PointOfSale" Expanded="true">
        <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.ShoppingCart">
            Tomar Pedido (POS)
        </MudNavLink>
        <MudNavLink Href="/caja" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Savings">
            Caja y Arqueo
        </MudNavLink>
        <MudNavLink Href="/cocina" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.AccessTime">
            Monitor de Cocina (KDS)
        </MudNavLink>
        @if (SaaSState.CurrentBusiness?.TablesEnabled ?? true)
        {
            <MudNavLink Href="/salon" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.TableRestaurant">
                Salón / Mesas
            </MudNavLink>
            <MudNavLink Href="/reservas" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.EventSeat">
                Reservas de Mesas
            </MudNavLink>
        }
        <MudNavLink Href="/orders-history" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ReceiptLong">
            Historial de Ventas
        </MudNavLink>
        <MudNavLink Href="/customers" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.People">
            Clientes y Fiados
        </MudNavLink>
    </MudNavGroup>

    <MudNavGroup Title="Carta y Recetas" Icon="@Icons.Material.Filled.MenuBook" Expanded="true">
        <MudNavLink Href="/products-admin" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Fastfood">
            Productos y Precios
        </MudNavLink>
        <MudNavLink Href="/categories" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Category">
            Categorías
        </MudNavLink>
        <MudNavLink Href="/recetas" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.AutoStories">
            Recetas y Costeo (CMV)
        </MudNavLink>
    </MudNavGroup>

    <MudNavGroup Title="Stock e Insumos" Icon="@Icons.Material.Filled.Inventory" Expanded="true">
        <MudNavLink Href="/insumos" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Warehouse">
            Insumos, Compras y Mermas
        </MudNavLink>
    </MudNavGroup>

    <MudNavGroup Title="Gastos y Consumos" Icon="@Icons.Material.Filled.AccountBalanceWallet">
        <MudNavLink Href="/expenses" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.MoneyOff">
            Gastos Operativos
        </MudNavLink>
        <MudNavLink Href="/consumptions" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Badge">
            Consumo Empleados
        </MudNavLink>
    </MudNavGroup>

    <AuthorizeView Roles="Owner,Admin,Tester">
        <Authorized>
            <MudNavGroup Title="Administración" Icon="@Icons.Material.Filled.AdminPanelSettings" Expanded="true">
                <MudNavLink Href="/dashboard" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Analytics">
                    Finanzas y Resumen
                </MudNavLink>
                <MudNavLink Href="/reportes-avanzados" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.TrendingUp">
                    Reportes Avanzados
                </MudNavLink>
                <MudNavLink Href="/users" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ManageAccounts">
                    Equipo y Usuarios
                </MudNavLink>
                <MudNavLink Href="/settings" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Store">
                    Configuración Local
                </MudNavLink>
                <MudNavLink Href="/subscription" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.CardMembership">
                    Planes y Suscripción
                </MudNavLink>
            </MudNavGroup>
        </Authorized>
    </AuthorizeView>

    <MudDivider Class="my-3" />
    <MudNavLink Href="/legal" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Gavel">
        Términos Legales
    </MudNavLink>
</MudNavMenu>

@code {
    protected override void OnInitialized()
    {
        SaaSState.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        SaaSState.OnChange -= StateHasChanged;
    }
}