@inject SaaSStateService SaaSState
@inject NavigationManager Navigation

@if (IsEnabled)
{
    @ChildContent
}
else
{
    <MudContainer MaxWidth="MaxWidth.Medium" Class="my-10">
        <MudCard Elevation="0" Class="pa-8 text-center" Style="border: 1px solid var(--saas-border); border-radius: 16px; box-shadow: var(--saas-shadow-sm);">
            <MudCardContent Class="pa-4">
                <div class="d-flex justify-center mb-4">
                    <div style="width: 56px; height: 56px; border-radius: 14px; background: var(--saas-surface-subtle); border: 1px solid var(--saas-border); display: flex; align-items: center; justify-content: center;">
                        <MudIcon Icon="@Icons.Material.Filled.WorkspacePremium" Style="color: var(--saas-primary); font-size: 28px;" />
                    </div>
                </div>
                
                <div class="mb-3">
                    <span class="saas-badge saas-badge-warning" style="font-size: 0.75rem; letter-spacing: 0.05em; padding: 4px 10px;">
                        PLAN PREMIUM
                    </span>
                </div>

                <MudText Typo="Typo.h5" Class="font-weight-bold mb-2" Style="color: var(--saas-text-primary); letter-spacing: -0.02em;">
                    @(string.IsNullOrWhiteSpace(FeatureName) ? "Funcionalidad Premium" : FeatureName)
                </MudText>

                <MudText Typo="Typo.body2" Class="mb-6 mx-auto" Style="color: var(--saas-text-secondary); max-width: 520px; line-height: 1.6;">
                    @(string.IsNullOrWhiteSpace(Description) 
                        ? "Esta función no está disponible en tu plan actual. Actualizá a Plan Premium para desbloquear insumos avanzados, recetas de costo, KDS de cocina, división de cuentas, reservas y reportes de rentabilidad."
                        : Description)
                </MudText>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Medium"
                           StartIcon="@Icons.Material.Filled.RocketLaunch"
                           Class="px-6 py-2 rounded-lg font-weight-bold"
                           OnClick="@(() => Navigation.NavigateTo("/subscription"))">
                    Mejorar a Plan Premium
                </MudButton>

                @if (SaaSState.IsTester)
                {
                    <div class="mt-6 pa-3 rounded-lg" style="background: var(--saas-surface-subtle); border: 1px dashed var(--saas-border); max-width: 440px; margin: 0 auto;">
                        <MudText Typo="Typo.caption" Class="font-weight-bold d-block mb-2" Style="color: var(--saas-text-secondary); letter-spacing: 0.05em;">
                            MODO TESTER INTERNO ACTIVO
                        </MudText>
                        <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Build"
                                   Class="rounded-lg"
                                   OnClick="@(() => _testerBypass = true)">
                            Probar Módulo (Bypass Tester)
                        </MudButton>
                    </div>
                }
            </MudCardContent>
        </MudCard>
    </MudContainer>
}

@code {
    [Parameter]
    public string Feature { get; set; } = string.Empty;

    [Parameter]
    public string? FeatureName { get; set; }

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private bool _testerBypass = false;
    private bool IsEnabled => _testerBypass || string.IsNullOrWhiteSpace(Feature) || SaaSState.HasFeature(Feature);

    protected override void OnInitialized()
    {
        SaaSState.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        SaaSState.OnChange -= StateHasChanged;
    }
}
