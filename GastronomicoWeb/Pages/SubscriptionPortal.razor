@page "/subscription"
@attribute [Authorize]
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject SaaSStateService State
@inject IJSRuntime JS

<PageTitle>Suscripción y Planes - Gastronómico SaaS</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="my-6">
    <div class="d-flex justify-space-between align-center mb-6">
        <div>
            <MudText Typo="Typo.h5" Class="font-weight-bold" Style="color: var(--saas-text-primary); letter-spacing: -0.02em;">Suscripción y Planes</MudText>
            <MudText Typo="Typo.body2" Style="color: var(--saas-text-secondary);">Administrá tu suscripción, capacidad operativa y funcionalidades contratadas.</MudText>
        </div>
        <MudButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadData" Class="rounded-lg">
            Actualizar
        </MudButton>
    </div>

    @if (loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4 rounded-lg" />
    }
    else if (subDetails != null)
    {
        var isExpired = subDetails.Status == "Expired" || subDetails.Status == "Suspended" || subDetails.Status == "Cancelled";
        var statusBadgeClass = subDetails.Status == "Active" ? "saas-badge-success" : (subDetails.Status == "Trial" ? "saas-badge-neutral" : "saas-badge-danger");

        <MudCard Elevation="0" Class="pa-6 rounded-xl mb-8" Style="border: 1px solid var(--saas-border); box-shadow: var(--saas-shadow-sm);">
            <div class="d-flex flex-wrap justify-space-between align-center">
                <div>
                    <div class="d-flex align-center gap-3">
                        <MudText Typo="Typo.h6" Class="font-weight-bold" Style="color: var(--saas-text-primary);">
                            Plan Actual: @(subDetails.Plan?.Name ?? "Plan Básico")
                        </MudText>
                        <span class="saas-badge @statusBadgeClass" style="font-weight: 600;">
                            @subDetails.Status
                        </span>
                        @if (subDetails.Plan?.Code == "premium")
                        {
                            <span class="saas-badge saas-badge-warning font-weight-bold">
                                ★ PREMIUM ACTIVO
                            </span>
                        }
                    </div>

                    <MudText Typo="Typo.body2" Class="mt-2" Style="color: var(--saas-text-secondary);">
                        @if (subDetails.Status == "Trial")
                        {
                            <span>Período de prueba vigente hasta: <b style="color: var(--saas-text-primary);">@(subDetails.TrialEndsAtUtc?.ToLocalTime().ToString("dd/MM/yyyy") ?? "-")</b></span>
                        }
                        else
                        {
                            <span>Período de facturación vigente hasta: <b style="color: var(--saas-text-primary);">@(subDetails.CurrentPeriodEndUtc?.ToLocalTime().ToString("dd/MM/yyyy") ?? "-")</b></span>
                        }
                    </MudText>
                </div>

                <div class="d-flex gap-2 mt-4 mt-sm-0">
                    @if (subDetails.Status == "Cancelled" || subDetails.Status == "Suspended" || subDetails.Status == "Expired")
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="ReactivateSubscription" Class="rounded-lg font-weight-bold">
                            Reactivar Suscripción
                        </MudButton>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="CancelSubscription" Class="rounded-lg font-weight-bold">
                            Cancelar Suscripción
                        </MudButton>
                    }
                </div>
            </div>

            <!-- Resource Usage Meters -->
            @if (subDetails.Plan != null && subDetails.Usage != null)
            {
                <MudDivider Class="my-5" Style="border-color: var(--saas-border-subtle);" />
                <div class="d-flex justify-space-between align-center mb-3">
                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold" Style="color: var(--saas-text-secondary); text-transform: uppercase; letter-spacing: 0.05em; font-size: 0.75rem;">
                        Consumo de Capacidad y Recursos
                    </MudText>
                </div>
                <MudGrid>
                    <MudItem xs="12" sm="6" md="3">
                        <div class="pa-4 rounded-xl" style="background: var(--saas-surface-subtle); border: 1px solid var(--saas-border);">
                            <div class="d-flex justify-space-between align-center mb-1">
                                <MudText Typo="Typo.caption" Class="font-weight-bold" Style="color: var(--saas-text-secondary); letter-spacing: 0.04em;">USUARIOS / MOZOS</MudText>
                                <span style="font-size: 0.75rem; color: var(--saas-text-secondary); font-weight: 600;">@GetProgressValue(subDetails.Usage.Users, subDetails.Plan.MaxUsers)%</span>
                            </div>
                            <MudText Typo="Typo.h6" Class="font-weight-bold" Style="color: var(--saas-text-primary);">@subDetails.Usage.Users <span style="font-size: 0.875rem; color: var(--saas-text-muted); font-weight: 500;">/ @subDetails.Plan.MaxUsers</span></MudText>
                            <MudProgressLinear Color="@GetProgressColor(subDetails.Usage.Users, subDetails.Plan.MaxUsers)"
                                               Value="@GetProgressValue(subDetails.Usage.Users, subDetails.Plan.MaxUsers)" Class="mt-2 rounded-sm" Style="height: 6px;" />
                        </div>
                    </MudItem>

                    <MudItem xs="12" sm="6" md="3">
                        <div class="pa-4 rounded-xl" style="background: var(--saas-surface-subtle); border: 1px solid var(--saas-border);">
                            <div class="d-flex justify-space-between align-center mb-1">
                                <MudText Typo="Typo.caption" Class="font-weight-bold" Style="color: var(--saas-text-secondary); letter-spacing: 0.04em;">PRODUCTOS EN CARTA</MudText>
                                <span style="font-size: 0.75rem; color: var(--saas-text-secondary); font-weight: 600;">@GetProgressValue(subDetails.Usage.Products, subDetails.Plan.MaxProducts)%</span>
                            </div>
                            <MudText Typo="Typo.h6" Class="font-weight-bold" Style="color: var(--saas-text-primary);">@subDetails.Usage.Products <span style="font-size: 0.875rem; color: var(--saas-text-muted); font-weight: 500;">/ @subDetails.Plan.MaxProducts</span></MudText>
                            <MudProgressLinear Color="@GetProgressColor(subDetails.Usage.Products, subDetails.Plan.MaxProducts)"
                                               Value="@GetProgressValue(subDetails.Usage.Products, subDetails.Plan.MaxProducts)" Class="mt-2 rounded-sm" Style="height: 6px;" />
                        </div>
                    </MudItem>

                    <MudItem xs="12" sm="6" md="3">
                        <div class="pa-4 rounded-xl" style="background: var(--saas-surface-subtle); border: 1px solid var(--saas-border);">
                            <div class="d-flex justify-space-between align-center mb-1">
                                <MudText Typo="Typo.caption" Class="font-weight-bold" Style="color: var(--saas-text-secondary); letter-spacing: 0.04em;">MESAS DE SALÓN</MudText>
                                <span style="font-size: 0.75rem; color: var(--saas-text-secondary); font-weight: 600;">@GetProgressValue(subDetails.Usage.Tables, subDetails.Plan.MaxTables)%</span>
                            </div>
                            <MudText Typo="Typo.h6" Class="font-weight-bold" Style="color: var(--saas-text-primary);">@subDetails.Usage.Tables <span style="font-size: 0.875rem; color: var(--saas-text-muted); font-weight: 500;">/ @subDetails.Plan.MaxTables</span></MudText>
                            <MudProgressLinear Color="@GetProgressColor(subDetails.Usage.Tables, subDetails.Plan.MaxTables)"
                                               Value="@GetProgressValue(subDetails.Usage.Tables, subDetails.Plan.MaxTables)" Class="mt-2 rounded-sm" Style="height: 6px;" />
                        </div>
                    </MudItem>

                    <MudItem xs="12" sm="6" md="3">
                        <div class="pa-4 rounded-xl" style="background: var(--saas-surface-subtle); border: 1px solid var(--saas-border);">
                            <div class="d-flex justify-space-between align-center mb-1">
                                <MudText Typo="Typo.caption" Class="font-weight-bold" Style="color: var(--saas-text-secondary); letter-spacing: 0.04em;">CLIENTES REGISTRADOS</MudText>
                                <span style="font-size: 0.75rem; color: var(--saas-text-secondary); font-weight: 600;">@GetProgressValue(subDetails.Usage.Customers, subDetails.Plan.MaxCustomers)%</span>
                            </div>
                            <MudText Typo="Typo.h6" Class="font-weight-bold" Style="color: var(--saas-text-primary);">@subDetails.Usage.Customers <span style="font-size: 0.875rem; color: var(--saas-text-muted); font-weight: 500;">/ @subDetails.Plan.MaxCustomers</span></MudText>
                            <MudProgressLinear Color="@GetProgressColor(subDetails.Usage.Customers, subDetails.Plan.MaxCustomers)"
                                               Value="@GetProgressValue(subDetails.Usage.Customers, subDetails.Plan.MaxCustomers)" Class="mt-2 rounded-sm" Style="height: 6px;" />
                        </div>
                    </MudItem>
                </MudGrid>
            }
        </MudCard>
    }

    <!-- Plans Comparison Grid -->
    <div class="mb-4">
        <MudText Typo="Typo.h6" Class="font-weight-bold" Style="color: var(--saas-text-primary);">Comparativa de Planes</MudText>
        <MudText Typo="Typo.body2" Style="color: var(--saas-text-secondary);">Elegí el plan que mejor se adapte a la escala de tu gastronomía.</MudText>
    </div>

    <MudGrid>
        @foreach (var plan in plans)
        {
            var isCurrent = subDetails?.Plan?.Code == plan.Code || (subDetails?.Plan == null && plan.Code == "basic");
            var isPremiumCard = plan.Code == "premium";

            <MudItem xs="12" md="6">
                <MudCard Elevation="0"
                         Class="rounded-xl d-flex flex-column h-100"
                         Style="@(isPremiumCard 
                                    ? "border: 2px solid var(--saas-primary); box-shadow: var(--saas-shadow-md);" 
                                    : "border: 1px solid var(--saas-border); box-shadow: var(--saas-shadow-xs);")">
                    <MudCardHeader Class="pb-2">
                        <CardHeaderContent>
                            <div class="d-flex justify-space-between align-center">
                                <div class="d-flex align-center gap-2">
                                    <MudText Typo="Typo.h5" Class="font-weight-bold" Style="color: var(--saas-text-primary); letter-spacing: -0.02em;">@plan.Name</MudText>
                                    @if (isPremiumCard)
                                    {
                                        <span class="saas-badge saas-badge-warning" style="font-size: 0.7rem; font-weight: 700;">
                                            RECOMENDADO
                                        </span>
                                    }
                                </div>
                                @if (isCurrent)
                                {
                                    <span class="saas-badge saas-badge-success" style="font-weight: 700;">
                                        PLAN ACTUAL
                                    </span>
                                }
                            </div>
                            <div class="mt-3 mb-1">
                                @if (plan.MonthlyPrice > 0)
                                {
                                    <div class="d-flex align-baseline gap-1">
                                        <span style="font-size: 2rem; font-weight: 800; color: var(--saas-text-primary); letter-spacing: -0.03em;">$@plan.MonthlyPrice.ToString("N0")</span>
                                        <span style="color: var(--saas-text-secondary); font-size: 0.875rem;">/ mes (@plan.Currency)</span>
                                    </div>
                                }
                                else
                                {
                                    <span style="font-size: 2rem; font-weight: 800; color: var(--saas-text-primary); letter-spacing: -0.03em;">Gratis</span>
                                }
                            </div>
                            <MudText Typo="Typo.body2" Style="color: var(--saas-text-secondary);">@plan.Description</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>

                    <MudCardContent Class="pt-2 flex-grow-1">
                        <MudText Typo="Typo.caption" Class="font-weight-bold d-block mb-3" Style="color: var(--saas-text-secondary); letter-spacing: 0.05em; text-transform: uppercase;">
                            Límites de Capacidad
                        </MudText>
                        <div class="d-flex flex-column gap-2 mb-4" style="font-size: 0.875rem; color: var(--saas-text-primary);">
                            <div class="d-flex align-center gap-2">
                                <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Small" Style="color: var(--saas-text-secondary);" />
                                <span>Hasta <b>@plan.MaxUsers</b> usuarios simultáneos</span>
                            </div>
                            <div class="d-flex align-center gap-2">
                                <MudIcon Icon="@Icons.Material.Filled.MenuBook" Size="Size.Small" Style="color: var(--saas-text-secondary);" />
                                <span>Hasta <b>@plan.MaxProducts</b> productos en carta</span>
                            </div>
                            <div class="d-flex align-center gap-2">
                                <MudIcon Icon="@Icons.Material.Filled.TableBar" Size="Size.Small" Style="color: var(--saas-text-secondary);" />
                                <span>Hasta <b>@plan.MaxTables</b> mesas de salón</span>
                            </div>
                            <div class="d-flex align-center gap-2">
                                <MudIcon Icon="@Icons.Material.Filled.Badge" Size="Size.Small" Style="color: var(--saas-text-secondary);" />
                                <span>Hasta <b>@plan.MaxCustomers</b> clientes en cartera</span>
                            </div>
                        </div>

                        <MudDivider Class="my-3" Style="border-color: var(--saas-border-subtle);" />
                        <MudText Typo="Typo.caption" Class="font-weight-bold d-block mb-3" Style="color: var(--saas-text-secondary); letter-spacing: 0.05em; text-transform: uppercase;">
                            Módulos y Funcionalidades
                        </MudText>

                        <div class="d-flex flex-column gap-2" style="font-size: 0.875rem; color: var(--saas-text-primary);">
                            <div class="d-flex align-center gap-2">
                                <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Style="color: #10b981;" />
                                <span>Ventas por mostrador y delivery</span>
                            </div>
                            <div class="d-flex align-center gap-2">
                                <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Style="color: #10b981;" />
                                <span>Mapa de mesas y comandas de salón</span>
                            </div>
                            <div class="d-flex align-center gap-2">
                                <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Style="color: #10b981;" />
                                <span>Caja, arqueo y turnos de cajero</span>
                            </div>
                            <div class="d-flex align-center gap-2">
                                <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Style="color: #10b981;" />
                                <span>Clientes, cuentas corrientes y fiados</span>
                            </div>
                            
                            @if (isPremiumCard)
                            {
                                <div class="d-flex align-center gap-2">
                                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Style="color: var(--saas-primary);" />
                                    <b>Control de insumos, compras y mermas</b>
                                </div>
                                <div class="d-flex align-center gap-2">
                                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Style="color: var(--saas-primary);" />
                                    <b>Fichas técnicas, recetas y costeo automático</b>
                                </div>
                                <div class="d-flex align-center gap-2">
                                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Style="color: var(--saas-primary);" />
                                    <b>Monitor KDS de cocina en vivo con SignalR</b>
                                </div>
                                <div class="d-flex align-center gap-2">
                                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Style="color: var(--saas-primary);" />
                                    <b>Libro de reservas de salón y comensales</b>
                                </div>
                                <div class="d-flex align-center gap-2">
                                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Style="color: var(--saas-primary);" />
                                    <b>División de cuentas (split bills) y propinas</b>
                                </div>
                                <div class="d-flex align-center gap-2">
                                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Style="color: var(--saas-primary);" />
                                    <b>Reportes avanzados: CMV, márgenes y exportación</b>
                                </div>
                            }
                            else
                            {
                                <div class="d-flex align-center gap-2" style="color: #94a3b8;">
                                    <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" Style="color: #cbd5e1;" />
                                    <span>Sin insumos ni recetas avanzadas</span>
                                </div>
                                <div class="d-flex align-center gap-2" style="color: #94a3b8;">
                                    <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" Style="color: #cbd5e1;" />
                                    <span>Sin monitor de cocina KDS</span>
                                </div>
                                <div class="d-flex align-center gap-2" style="color: #94a3b8;">
                                    <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" Style="color: #cbd5e1;" />
                                    <span>Sin división de cuentas ni reservas</span>
                                </div>
                            }
                        </div>
                    </MudCardContent>

                    <MudCardActions Class="pa-6 pt-0">
                        @if (isCurrent)
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Default" FullWidth="true" Disabled="true" Class="rounded-lg py-2">
                                Plan Actual en Uso
                            </MudButton>
                        }
                        else
                        {
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       FullWidth="true"
                                       Size="Size.Large"
                                       Class="rounded-lg py-2 font-weight-bold"
                                       StartIcon="@(isPremiumCard ? Icons.Material.Filled.WorkspacePremium : Icons.Material.Filled.SwapHoriz)"
                                       OnClick="@(() => SwitchPlanAsync(plan.Code))"
                                       Disabled="switching">
                                @(switching ? "Cambiando..." : (isPremiumCard ? "Actualizar a Plan Premium" : "Cambiar a Plan Básico"))
                            </MudButton>
                        }
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
</MudContainer>

@code {
    private SubscriptionDetailsDto? subDetails;
    private List<Plan> plans = new();
    private bool loading = true;
    private bool switching = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        loading = true;
        try
        {
            var plansTask = Http.GetFromJsonAsync<List<Plan>>("api/billing/plans");
            var subTask = Http.GetFromJsonAsync<SubscriptionDetailsDto>("api/billing/subscription");

            await Task.WhenAll(plansTask, subTask);

            plans = await plansTask ?? new();
            subDetails = await subTask;
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error al cargar suscripción: " + ex.Message, Severity.Error);
        }
        finally
        {
            loading = false;
        }
    }

    private async Task SwitchPlanAsync(string planCode)
    {
        switching = true;
        try
        {
            var res = await Http.PostAsync($"api/billing/switch-plan/{planCode}", null);
            if (res.IsSuccessStatusCode)
            {
                Snackbar.Add($"Plan actualizado con éxito a {planCode.ToUpper()}!", Severity.Success);
                await State.RefreshSubscriptionStateAsync();
                await LoadData();
            }
            else
            {
                var err = await res.Content.ReadAsStringAsync();
                Snackbar.Add("Error al cambiar plan: " + err, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error: " + ex.Message, Severity.Error);
        }
        finally
        {
            switching = false;
        }
    }

    private async Task ReactivateSubscription()
    {
        var res = await Http.PostAsync("api/billing/reactivate", null);
        if (res.IsSuccessStatusCode)
        {
            Snackbar.Add("Suscripción reactivada con éxito", Severity.Success);
            await State.RefreshSubscriptionStateAsync();
            await LoadData();
        }
        else
        {
            var err = await res.Content.ReadAsStringAsync();
            Snackbar.Add(err, Severity.Warning);
        }
    }

    private async Task CancelSubscription()
    {
        bool confirm = await JS.InvokeAsync<bool>("confirm", "¿Estás seguro de que deseas cancelar la suscripción?");
        if (!confirm) return;

        var res = await Http.PostAsync("api/billing/cancel", null);
        if (res.IsSuccessStatusCode)
        {
            Snackbar.Add("Suscripción cancelada", Severity.Info);
            await State.RefreshSubscriptionStateAsync();
            await LoadData();
        }
    }

    private double GetProgressValue(int current, int max)
    {
        if (max <= 0) return 0;
        return Math.Min(100, Math.Round(((double)current / max) * 100, 1));
    }

    private Color GetProgressColor(int current, int max)
    {
        var val = GetProgressValue(current, max);
        if (val >= 90) return Color.Error;
        if (val >= 70) return Color.Warning;
        return Color.Primary;
    }
}
