@page "/reservas"
@using RotiseriaWeb.Models
@using RotiseriaWeb.Services
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Reservas - SaaS Gastronómico</PageTitle>

<FeatureGate Feature="@FeatureCodes.Reservations"
             FeatureName="Módulo de Reservas de Mesas"
             Description="Gestioná el libro de reservas del restaurante o bar: asignación de mesas, confirmación de clientes, control de comensales y seguimiento de asistencia.">

    <div class="d-flex justify-space-between align-center mb-4">
        <div>
            <MudText Typo="Typo.h4" Color="Color.Primary">Libro de Reservas</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Gestión de mesas reservadas, horarios y clientes para el salón.</MudText>
        </div>
        <div class="d-flex gap-2">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadReservations">
                Actualizar
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialog">
                Nueva Reserva
            </MudButton>
        </div>
    </div>

    <!-- Filters -->
    <MudCard Elevation="1" Class="pa-3 mb-4">
        <div class="d-flex flex-wrap align-center gap-4">
            <MudDatePicker @bind-Date="filterDate" Label="Fecha de Reserva" DateFormat="dd/MM/yyyy" Clearable="true" />
            <MudSelect T="ReservationStatus?" @bind-Value="filterStatus" Label="Estado" Clearable="true">
                <MudSelectItem T="ReservationStatus?" Value="@(ReservationStatus.Pending)">Pendiente</MudSelectItem>
                <MudSelectItem T="ReservationStatus?" Value="@(ReservationStatus.Confirmed)">Confirmada</MudSelectItem>
                <MudSelectItem T="ReservationStatus?" Value="@(ReservationStatus.Seated)">En Mesa / Sentados</MudSelectItem>
                <MudSelectItem T="ReservationStatus?" Value="@(ReservationStatus.Cancelled)">Cancelada</MudSelectItem>
                <MudSelectItem T="ReservationStatus?" Value="@(ReservationStatus.NoShow)">No Asistió (No Show)</MudSelectItem>
            </MudSelect>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="LoadReservations" StartIcon="@Icons.Material.Filled.FilterAlt">
                Aplicar Filtros
            </MudButton>
        </div>
    </MudCard>

    @if (loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
    }
    else if (!reservations.Any())
    {
        <MudPaper Class="pa-6 text-center" Elevation="1">
            <MudText Typo="Typo.body1" Color="Color.Secondary">No hay reservas registradas para el criterio seleccionado.</MudText>
        </MudPaper>
    }
    else
    {
        <MudTable Items="@reservations" Dense="true" Hover="true" Striped="true" Elevation="2">
            <HeaderContent>
                <MudTh>Fecha y Hora</MudTh>
                <MudTh>Cliente</MudTh>
                <MudTh>Teléfono / Contacto</MudTh>
                <MudTh>Comensales</MudTh>
                <MudTh>Mesa Asignada</MudTh>
                <MudTh>Estado</MudTh>
                <MudTh>Notas</MudTh>
                <MudTh Style="text-align: center;">Acciones Rápidas</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd><b>@context.ReservationDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</b></MudTd>
                <MudTd>@context.CustomerName</MudTd>
                <MudTd>@(string.IsNullOrWhiteSpace(context.CustomerPhone) ? "-" : context.CustomerPhone)</MudTd>
                <MudTd><MudChip T="string" Size="Size.Small" Color="Color.Default">@context.Pax personas</MudChip></MudTd>
                <MudTd>
                    @(context.Table != null ? $"Mesa #{context.Table.Number}" : (context.TableId.HasValue ? $"Mesa #{context.TableId}" : "Sin asignar"))
                </MudTd>
                <MudTd>
                    @switch (context.Status)
                    {
                        case ReservationStatus.Pending:
                            <MudChip T="string" Color="Color.Warning" Size="Size.Small">Pendiente</MudChip>
                            break;
                        case ReservationStatus.Confirmed:
                            <MudChip T="string" Color="Color.Info" Size="Size.Small">Confirmada</MudChip>
                            break;
                        case ReservationStatus.Seated:
                            <MudChip T="string" Color="Color.Success" Size="Size.Small">En Mesa</MudChip>
                            break;
                        case ReservationStatus.Cancelled:
                            <MudChip T="string" Color="Color.Default" Size="Size.Small">Cancelada</MudChip>
                            break;
                        case ReservationStatus.NoShow:
                            <MudChip T="string" Color="Color.Error" Size="Size.Small">No Show</MudChip>
                            break;
                    }
                </MudTd>
                <MudTd>@(string.IsNullOrWhiteSpace(context.Notes) ? "-" : context.Notes)</MudTd>
                <MudTd Style="text-align: center;">
                    @if (context.Status == ReservationStatus.Pending)
                    {
                        <MudTooltip Text="Confirmar Reserva">
                            <MudIconButton Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Info"
                                           OnClick="@(() => UpdateStatusAsync(context.Id, ReservationStatus.Confirmed))" />
                        </MudTooltip>
                    }
                    @if (context.Status == ReservationStatus.Pending || context.Status == ReservationStatus.Confirmed)
                    {
                        <MudTooltip Text="Sentar en Mesa">
                            <MudIconButton Icon="@Icons.Material.Filled.TableRestaurant" Size="Size.Small" Color="Color.Success"
                                           OnClick="@(() => UpdateStatusAsync(context.Id, ReservationStatus.Seated))" />
                        </MudTooltip>
                        <MudTooltip Text="Marcar No Show">
                            <MudIconButton Icon="@Icons.Material.Filled.PersonOff" Size="Size.Small" Color="Color.Warning"
                                           OnClick="@(() => UpdateStatusAsync(context.Id, ReservationStatus.NoShow))" />
                        </MudTooltip>
                        <MudTooltip Text="Cancelar Reserva">
                            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Error"
                                           OnClick="@(() => UpdateStatusAsync(context.Id, ReservationStatus.Cancelled))" />
                        </MudTooltip>
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
    }

    <!-- Dialog Create Reservation -->
    <MudDialog @bind-Visible="dialogVisible" Options="dialogOptions">
        <TitleContent>
            <MudText Typo="Typo.h6">Nueva Reserva de Mesa</MudText>
        </TitleContent>
        <DialogContent>
            <MudTextField @bind-Value="createModel.CustomerName" Label="Nombre del Cliente" Variant="Variant.Outlined" Required="true" Class="mb-3" />
            <MudTextField @bind-Value="createModel.CustomerPhone" Label="Teléfono de Contacto" Variant="Variant.Outlined" Class="mb-3" />
            
            <div class="d-flex gap-3 mb-3">
                <MudDatePicker @bind-Date="selectedDate" Label="Fecha" DateFormat="dd/MM/yyyy" />
                <MudTimePicker @bind-Time="selectedTime" Label="Hora" />
            </div>

            <div class="d-flex gap-3 mb-3">
                <MudNumericField @bind-Value="createModel.Pax" Label="Comensales (Pax)" Variant="Variant.Outlined" Min="1" />
                <MudSelect T="int?" @bind-Value="createModel.TableId" Label="Mesa Sugerida (Opcional)" Variant="Variant.Outlined" Clearable="true">
                    @foreach (var table in availableTables)
                    {
                        <MudSelectItem T="int?" Value="@((int?)table.Id)">Mesa #@table.Number (@table.Status)</MudSelectItem>
                    }
                </MudSelect>
            </div>

            <MudTextField @bind-Value="createModel.Notes" Label="Notas / Preferencias (ej. cumpleaños, patio)" Variant="Variant.Outlined" Lines="2" Class="mb-3" />
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="@(() => dialogVisible = false)">Cancelar</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveReservationAsync" Disabled="saving">
                @(saving ? "Guardando..." : "Crear Reserva")
            </MudButton>
        </DialogActions>
    </MudDialog>

</FeatureGate>

@code {
    private List<ReservationDto> reservations = new();
    private List<Table> availableTables = new();
    private bool loading = true;
    private DateTime? filterDate;
    private ReservationStatus? filterStatus;

    private bool dialogVisible = false;
    private bool saving = false;
    private ReservationWriteRequest createModel = new();
    private DateTime? selectedDate = DateTime.Today;
    private TimeSpan? selectedTime = DateTime.Now.TimeOfDay.Add(TimeSpan.FromHours(1));

    private DialogOptions dialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };

    protected override async Task OnInitializedAsync()
    {
        await LoadReservations();
        await LoadTables();
    }

    private async Task LoadTables()
    {
        try
        {
            var tables = await Http.GetFromJsonAsync<List<Table>>("api/tables");
            availableTables = tables ?? new();
        }
        catch { }
    }

    private async Task LoadReservations()
    {
        loading = true;
        try
        {
            var url = "api/reservations?";
            if (filterDate.HasValue)
                url += $"date={filterDate.Value:yyyy-MM-dd}&";
            if (filterStatus.HasValue)
                url += $"status={filterStatus.Value}&";

            var res = await Http.GetFromJsonAsync<List<ReservationDto>>(url.TrimEnd('&', '?'));
            reservations = res ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar reservas: {ex.Message}", Severity.Error);
        }
        finally
        {
            loading = false;
        }
    }

    private void OpenCreateDialog()
    {
        selectedDate = DateTime.Today;
        selectedTime = TimeSpan.FromHours(20); // 20:00 default
        createModel = new ReservationWriteRequest { Pax = 2 };
        dialogVisible = true;
    }

    private async Task SaveReservationAsync()
    {
        if (string.IsNullOrWhiteSpace(createModel.CustomerName))
        {
            Snackbar.Add("El nombre del cliente es obligatorio", Severity.Warning);
            return;
        }

        var date = selectedDate ?? DateTime.Today;
        var time = selectedTime ?? TimeSpan.FromHours(20);
        createModel.ReservationDate = date.Date + time;

        saving = true;
        try
        {
            var res = await Http.PostAsJsonAsync("api/reservations", createModel);
            if (res.IsSuccessStatusCode)
            {
                Snackbar.Add("Reserva registrada con éxito", Severity.Success);
                dialogVisible = false;
                await LoadReservations();
            }
            else
            {
                var err = await res.Content.ReadAsStringAsync();
                Snackbar.Add($"Error al crear reserva: {err}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            saving = false;
        }
    }

    private async Task UpdateStatusAsync(int id, ReservationStatus newStatus)
    {
        try
        {
            var req = new UpdateReservationStatusRequest { Status = newStatus };
            var res = await Http.PatchAsJsonAsync($"api/reservations/{id}/status", req);
            if (res.IsSuccessStatusCode)
            {
                Snackbar.Add("Estado de reserva actualizado", Severity.Success);
                await LoadReservations();
            }
            else
            {
                var err = await res.Content.ReadAsStringAsync();
                Snackbar.Add($"Error: {err}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }
}
