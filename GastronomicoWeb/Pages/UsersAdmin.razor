@page "/users"
@attribute [Authorize(Roles = "Owner,Admin,Tester")]
@inject HttpClient Http
@inject ISnackbar Snackbar

<PageTitle>Personal y Usuarios - SaaS Gastronómico</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-2 mb-8">
    <div class="d-flex flex-wrap justify-space-between align-center mb-6 gap-2">
        <div>
            <MudText Typo="Typo.h4" Style="font-weight: 700; letter-spacing: -0.02em;">Personal y Equipo del Local</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Gestiona las cuentas y permisos de administradores, encargados de salón y mozos/cocineros.</MudText>
        </div>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="OpenCreateDialog" Size="Size.Small">
            Nuevo Empleado
        </MudButton>
    </div>

    <div class="mud-paper overflow-hidden">
        <MudTable Items="@users" Hover="true" Elevation="0" Loading="@loading">
            <HeaderContent>
                <MudTh>Nombre</MudTh>
                <MudTh>Email de Acceso</MudTh>
                <MudTh>Rol / Permisos</MudTh>
                <MudTh>Último Ingreso</MudTh>
                <MudTh>Estado</MudTh>
                <MudTh Style="text-align: right;">Acciones</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Nombre">
                    <div class="d-flex align-center gap-2">
                        <div style="width: 32px; height: 32px; border-radius: 50%; background-color: var(--saas-primary); color: var(--saas-primary-text); display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.75rem;">
                            @(context.FullName.Length > 0 ? context.FullName[0].ToString().ToUpperInvariant() : "U")
                        </div>
                        <span style="font-weight: 600; color: var(--saas-text-primary);">@context.FullName</span>
                    </div>
                </MudTd>
                <MudTd DataLabel="Email">@context.Email</MudTd>
                <MudTd DataLabel="Rol">
                    <span class="saas-badge @(context.Role == "Owner" ? "saas-badge-warning" : (context.Role == "Admin" ? "saas-badge-info" : "saas-badge-neutral"))">
                        @context.Role
                    </span>
                </MudTd>
                <MudTd DataLabel="Último Acceso">
                    <span style="color: var(--saas-text-secondary); font-size: 0.8125rem;">
                        @(context.LastLoginAtUtc.HasValue ? context.LastLoginAtUtc.Value.ToString("dd/MM/yyyy HH:mm") : "Nunca ingresó")
                    </span>
                </MudTd>
                <MudTd DataLabel="Estado">
                    <span class="saas-badge @(context.IsActive ? "saas-badge-success" : "saas-badge-error")">
                        @(context.IsActive ? "Activo" : "Bloqueado")
                    </span>
                </MudTd>
                <MudTd DataLabel="Acciones" Style="text-align: right;">
                    @if (context.Role != "Owner")
                    {
                        <MudTooltip Text="Modificar Empleado">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Default" Size="Size.Small"
                                           OnClick="@(() => OpenEditDialog(context))" Style="width: 28px; height: 28px; padding: 2px;" />
                        </MudTooltip>
                    }
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <div class="pa-8 text-center text-muted">
                    <MudIcon Icon="@Icons.Material.Filled.Group" Size="Size.Large" Color="Color.Secondary" Class="mb-2" />
                    <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">No hay empleados registrados</MudText>
                </div>
            </NoRecordsContent>
        </MudTable>
    </div>
</MudContainer>

<MudDialog @bind-Visible="dialogOpen" Options="dialogOptions">
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.Badge" Size="Size.Small" />
            <MudText Typo="Typo.subtitle1" Style="font-weight: 700;">@(isEditing ? "Modificar Empleado" : "Dar de Alta Empleado")</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        @if (!isEditing)
        {
            <MudTextField @bind-Value="createModel.Email" Label="Correo Electrónico (Login)" Required="true" Variant="Variant.Outlined" Class="mb-3" />
            <MudTextField @bind-Value="createModel.FullName" Label="Nombre y Apellido" Required="true" Variant="Variant.Outlined" Class="mb-3" />
            <MudTextField @bind-Value="createModel.Password" Label="Contraseña Inicial (mínimo 8 caracteres)" InputType="InputType.Password" Required="true" Variant="Variant.Outlined" Class="mb-3" />
            <MudSelect T="string" @bind-Value="createModel.Role" Label="Rol y Permisos" Variant="Variant.Outlined" Class="mb-3" AnchorOrigin="Origin.BottomCenter">
                <MudSelectItem Value="@("Admin")">Administrador (Control total excepto suscripción)</MudSelectItem>
                <MudSelectItem Value="@("Manager")">Encargado (Catálogo, salón, cocina, gastos)</MudSelectItem>
                <MudSelectItem Value="@("Employee")">Mozo / Cocina (Toma de pedidos y visualización)</MudSelectItem>
            </MudSelect>
        }
        else
        {
            <MudTextField @bind-Value="updateModel.FullName" Label="Nombre y Apellido" Required="true" Variant="Variant.Outlined" Class="mb-3" />
            <MudSelect T="string" @bind-Value="updateModel.Role" Label="Rol y Permisos" Variant="Variant.Outlined" Class="mb-3" AnchorOrigin="Origin.BottomCenter">
                <MudSelectItem Value="@("Admin")">Administrador</MudSelectItem>
                <MudSelectItem Value="@("Manager")">Encargado</MudSelectItem>
                <MudSelectItem Value="@("Employee")">Mozo / Empleado</MudSelectItem>
            </MudSelect>
            <MudCheckBox @bind-Value="updateModel.IsActive" Label="Usuario Habilitado para Acceder" Color="Color.Success" T="bool" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="@(() => dialogOpen = false)">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveUser">
            Guardar
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<UserDto> users = new();
    private bool loading = true;
    private bool dialogOpen = false;
    private bool isEditing = false;
    private int editingUserId = 0;
    private CreateUserRequest createModel = new();
    private UpdateUserRequest updateModel = new();
    private DialogOptions dialogOptions = new() { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        loading = true;
        try
        {
            var res = await Http.GetFromJsonAsync<List<UserDto>>("api/Users");
            users = res ?? new();
        }
        finally
        {
            loading = false;
        }
    }

    private void OpenCreateDialog()
    {
        isEditing = false;
        createModel = new CreateUserRequest { Role = "Employee" };
        dialogOpen = true;
    }

    private void OpenEditDialog(UserDto user)
    {
        isEditing = true;
        editingUserId = user.Id;
        updateModel = new UpdateUserRequest
        {
            FullName = user.FullName,
            Role = user.Role,
            IsActive = user.IsActive
        };
        dialogOpen = true;
    }

    private async Task SaveUser()
    {
        if (isEditing)
        {
            var res = await Http.PutAsJsonAsync($"api/Users/{editingUserId}", updateModel);
            if (res.IsSuccessStatusCode)
            {
                Snackbar.Add("Usuario actualizado", Severity.Success);
                dialogOpen = false;
                await LoadUsers();
            }
            else
            {
                var err = await res.Content.ReadAsStringAsync();
                Snackbar.Add("Error: " + err, Severity.Error);
            }
        }
        else
        {
            if (createModel.Password.Length < 8)
            {
                Snackbar.Add("La contraseña debe tener al menos 8 caracteres", Severity.Warning);
                return;
            }

            var res = await Http.PostAsJsonAsync("api/Users", createModel);
            if (res.IsSuccessStatusCode)
            {
                Snackbar.Add("Empleado registrado exitosamente", Severity.Success);
                dialogOpen = false;
                await LoadUsers();
            }
            else
            {
                var err = await res.Content.ReadAsStringAsync();
                Snackbar.Add("Error: " + err, Severity.Error);
            }
        }
    }
}
