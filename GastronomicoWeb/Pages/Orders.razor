@page "/orders-history"
@using RotiseriaWeb.Models
@using RotiseriaWeb.Services
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject SaaSStateService SaaSState

<PageTitle>Historial de Ventas - SaaS Gastronómico</PageTitle>

<style>
    @@media print {
        body * {
            visibility: hidden !important;
        }
        #order-history-receipt, #order-history-receipt * {
            visibility: visible !important;
        }
        #order-history-receipt {
            position: absolute !important;
            left: 0 !important;
            top: 0 !important;
            width: 78mm !important;
            margin: 0 !important;
            padding: 4mm !important;
            font-family: 'Courier New', Courier, monospace !important;
            font-size: 12px !important;
            color: black !important;
            background: white !important;
        }
    }
</style>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-2 mb-8">
    <div class="d-flex flex-wrap justify-space-between align-center mb-6 gap-2">
        <div>
            <MudText Typo="Typo.h4" Style="font-weight: 700; letter-spacing: -0.02em;">Historial de Ventas</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Registro cronológico de todas las comandas despachadas, mesas cobradas y envíos.</MudText>
        </div>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="CargarOrdenesAsync" StartIcon="@Icons.Material.Filled.Refresh" Size="Size.Small">
            Actualizar
        </MudButton>
    </div>

    <div class="mud-paper mb-4 overflow-hidden">
        <MudTable Items="@_orders" Hover="true" Breakpoint="Breakpoint.Sm" Loading="@_loading" Elevation="0">
            <HeaderContent>
                <MudTh># Pedido</MudTh>
                <MudTh>Fecha / Hora</MudTh>
                <MudTh>Modalidad</MudTh>
                <MudTh>Cliente</MudTh>
                <MudTh>Medio de Pago</MudTh>
                <MudTh Style="text-align: right;">Total</MudTh>
                <MudTh>Demora / Estado</MudTh>
                <MudTh Style="text-align: right;">Acciones</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="# Pedido">
                    <span style="font-weight: 700; color: var(--saas-text-primary);">#@context.Id</span>
                </MudTd>
                <MudTd DataLabel="Fecha">
                    <span style="font-size: 0.8125rem;">@context.Date.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                </MudTd>
                <MudTd DataLabel="Modalidad">
                    <span class="saas-badge @(context.OrderType == "Delivery" ? "saas-badge-warning" : (context.OrderType == "Salon" ? "saas-badge-info" : "saas-badge-neutral"))">
                        @context.OrderType
                    </span>
                </MudTd>
                <MudTd DataLabel="Cliente">
                    @(string.IsNullOrWhiteSpace(context.ClientName) ? (context.CustomerId.HasValue ? $"Cliente #{context.CustomerId}" : "-") : context.ClientName)
                </MudTd>
                <MudTd DataLabel="Pago">
                    <span class="saas-badge @(context.PaymentMethod == "Cuenta Corriente" ? "saas-badge-warning" : "saas-badge-success")">
                        @context.PaymentMethod
                    </span>
                </MudTd>
                <MudTd DataLabel="Total" Style="text-align: right;">
                    <span style="font-weight: 700; color: var(--saas-text-primary);">$ @context.Total.ToString("N2")</span>
                </MudTd>
                <MudTd DataLabel="Demora">
                    @if (context.DispatchedAt.HasValue)
                    {
                        <span style="color: var(--saas-text-secondary); font-size: 0.8125rem;">
                            ✓ @Math.Round((context.DispatchedAt.Value - context.Date).TotalMinutes) min
                        </span>
                    }
                    else
                    {
                        <span class="saas-badge saas-badge-info">En Curso</span>
                    }
                </MudTd>
                <MudTd DataLabel="Acciones" Style="text-align: right;">
                    <div class="d-flex justify-end gap-1">
                        <MudTooltip Text="Ver Detalle">
                            <MudIconButton Icon="@Icons.Material.Filled.Visibility" Color="Color.Default" Size="Size.Small"
                                           OnClick="@(() => VerDetalle(context))" Style="width: 28px; height: 28px; padding: 2px;" />
                        </MudTooltip>
                        <MudTooltip Text="Reimprimir Ticket">
                            <MudIconButton Icon="@Icons.Material.Filled.Print" Color="Color.Default" Size="Size.Small"
                                           OnClick="@(() => AbrirImpresion(context))" Style="width: 28px; height: 28px; padding: 2px;" />
                        </MudTooltip>
                    </div>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <div class="pa-8 text-center text-muted">
                    <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Size="Size.Large" Color="Color.Secondary" Class="mb-2" />
                    <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">No se encontraron ventas</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Aún no hay comandas registradas en el sistema.</MudText>
                </div>
            </NoRecordsContent>
        </MudTable>

        <div class="d-flex justify-space-between align-center pa-3" style="background-color: var(--saas-surface-subtle); border-top: 1px solid var(--saas-border-subtle);">
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                Mostrando página @_page de @Math.Max(1, _totalPages) (@_total ventas en total)
            </MudText>
            <div class="d-flex gap-2">
                <MudButton Variant="Variant.Outlined" Disabled="@(_page <= 1)" OnClick="PaginaAnterior" Size="Size.Small">
                    Anterior
                </MudButton>
                <MudButton Variant="Variant.Outlined" Disabled="@(_page >= _totalPages)" OnClick="PaginaSiguiente" Size="Size.Small">
                    Siguiente
                </MudButton>
            </div>
        </div>
    </div>
</MudContainer>

@* MODAL DETALLE DE ORDEN *@
<MudDialog @bind-Visible="_dialogDetalle" Options="_dialogOptions">
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.Receipt" Size="Size.Small" />
            <MudText Typo="Typo.subtitle1" Style="font-weight: 700;">Detalle de Comanda #@_selectedOrder?.Id</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        @if (_selectedOrder != null)
        {
            <div class="pa-3 rounded mb-3" style="background-color: var(--saas-surface-subtle); border: 1px solid var(--saas-border-subtle); font-size: 0.875rem;">
                <div class="d-flex justify-space-between mb-1">
                    <span style="color: var(--saas-text-secondary);">Modalidad:</span>
                    <b>@_selectedOrder.OrderType</b>
                </div>
                <div class="d-flex justify-space-between mb-1">
                    <span style="color: var(--saas-text-secondary);">Cliente:</span>
                    <b>@(string.IsNullOrWhiteSpace(_selectedOrder.ClientName) ? "-" : _selectedOrder.ClientName)</b>
                </div>
                @if (!string.IsNullOrWhiteSpace(_selectedOrder.DeliveryAddress))
                {
                    <div class="d-flex justify-space-between mb-1">
                        <span style="color: var(--saas-text-secondary);">Dirección Entrega:</span>
                        <span>@_selectedOrder.DeliveryAddress</span>
                    </div>
                }
                <div class="d-flex justify-space-between">
                    <span style="color: var(--saas-text-secondary);">Fecha y Hora:</span>
                    <span>@_selectedOrder.Date.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                </div>
            </div>

            <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-weight: 700; text-transform: uppercase;">Ítems de la Comanda</MudText>
            <div class="my-2" style="max-height: 200px; overflow-y: auto;">
                <MudList T="string" Dense="true">
                    @foreach (var it in _selectedOrder.Items)
                    {
                        <MudListItem T="string" Class="px-0 py-1">
                            <div class="d-flex justify-space-between align-center">
                                <div>
                                    <span style="font-weight: 600;">@it.Quantity x</span>
                                    <span class="ml-1">@it.ProductName</span>
                                </div>
                                <span style="font-weight: 600;">$@((it.Quantity * it.UnitPrice).ToString("N2"))</span>
                            </div>
                        </MudListItem>
                    }
                </MudList>
            </div>

            <MudDivider Class="my-2" />
            <div class="d-flex justify-space-between align-center mt-2">
                <MudText Typo="Typo.subtitle1" Style="font-weight: 700;">Total Facturado:</MudText>
                <MudText Typo="Typo.h5" Style="font-weight: 800; color: var(--saas-text-primary);">$ @_selectedOrder.Total.ToString("N2")</MudText>
            </div>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="@(() => _dialogDetalle = false)">Cerrar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Print"
                   OnClick="@(() => { _dialogDetalle = false; AbrirImpresion(_selectedOrder!); })">
            Imprimir Ticket
        </MudButton>
    </DialogActions>
</MudDialog>

@* MODAL DE IMPRESIÓN *@
<MudDialog @bind-Visible="_showReceiptModal" Options="_receiptDialogOptions">
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.Print" Size="Size.Small" />
            <MudText Typo="Typo.subtitle1" Style="font-weight: 700;">Ticket de Venta #@_selectedOrder?.Id</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        @if (_selectedOrder != null)
        {
            <div id="order-history-receipt" class="pa-4 thermal-receipt-preview" style="font-family: monospace; border-radius: 8px;">
                <div style="text-align: center; margin-bottom: 8px;">
                    <div style="font-size: 15px; font-weight: bold;">@(SaaSState.CurrentBusiness?.TradeName ?? "SAAS GASTRONOMICO")</div>
                    @if (!string.IsNullOrWhiteSpace(SaaSState.CurrentBusiness?.TaxId))
                    {
                        <div style="font-size: 11px;">CUIT: @SaaSState.CurrentBusiness.TaxId</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(SaaSState.CurrentBusiness?.Address))
                    {
                        <div style="font-size: 11px;">@SaaSState.CurrentBusiness.Address</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(SaaSState.CurrentBusiness?.Phone))
                    {
                        <div style="font-size: 11px;">Tel: @SaaSState.CurrentBusiness.Phone</div>
                    }
                    <div class="thermal-receipt-divider" style="margin: 8px 0;"></div>
                    <div style="font-size: 13px; font-weight: bold;">PEDIDO #@_selectedOrder.Id</div>
                    <div style="font-size: 11px;">Fecha: @_selectedOrder.Date.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                    <div style="font-size: 11px;">Tipo: @_selectedOrder.OrderType</div>
                    @if (!string.IsNullOrWhiteSpace(_selectedOrder.ClientName))
                    {
                        <div style="font-size: 11px;">Cliente: @_selectedOrder.ClientName</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_selectedOrder.DeliveryAddress))
                    {
                        <div style="font-size: 11px;">Dirección: @_selectedOrder.DeliveryAddress</div>
                    }
                </div>

                <div class="thermal-receipt-divider" style="margin: 8px 0;"></div>
                <table style="width: 100%; font-size: 12px; border-collapse: collapse;">
                    <thead>
                        <tr style="text-align: left; border-bottom: 1px solid var(--saas-border-subtle);">
                            <th>Cant</th>
                            <th>Prod</th>
                            <th style="text-align: right;">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var it in _selectedOrder.Items)
                        {
                            <tr>
                                <td style="vertical-align: top;">@it.Quantity</td>
                                <td style="vertical-align: top;">@it.ProductName</td>
                                <td style="text-align: right; vertical-align: top;">$@((it.Quantity * it.UnitPrice).ToString("N2"))</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div style="border-bottom: 1px dashed black; margin: 8px 0;"></div>

                <div style="display: flex; justify-content: space-between; font-size: 12px; margin-bottom: 2px;">
                    <span>Pago:</span>
                    <span style="font-weight: bold;">@_selectedOrder.PaymentMethod</span>
                </div>
                @if (_selectedOrder.DeliveryCost > 0)
                {
                    <div style="display: flex; justify-content: space-between; font-size: 12px; margin-bottom: 2px;">
                        <span>Envío:</span>
                        <span>$@_selectedOrder.DeliveryCost.ToString("N2")</span>
                    </div>
                }
                <div style="display: flex; justify-content: space-between; font-size: 14px; font-weight: bold; margin-top: 6px; padding-top: 4px; border-top: 1px solid #ddd;">
                    <span>TOTAL:</span>
                    <span>$@_selectedOrder.Total.ToString("N2")</span>
                </div>

                <div style="text-align: center; margin-top: 12px; font-size: 11px; color: #555;">
                    Comprobante no fiscal - Documento interno
                </div>
            </div>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="@(() => _showReceiptModal = false)">Cerrar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Print" OnClick="PrintReceipt">
            Imprimir
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<Order> _orders = new();
    private bool _loading = true;
    private int _page = 1;
    private int _pageSize = 25;
    private int _total = 0;
    private int _totalPages => (int)Math.Ceiling((double)_total / _pageSize);

    private Order? _selectedOrder;
    private bool _dialogDetalle = false;
    private bool _showReceiptModal = false;
    private DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
    private DialogOptions _receiptDialogOptions = new() { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, CloseButton = true };

    protected override async Task OnInitializedAsync()
    {
        await CargarOrdenesAsync();
    }

    private async Task CargarOrdenesAsync()
    {
        _loading = true;
        try
        {
            var res = await Http.GetFromJsonAsync<PagedResult<Order>>($"api/Orders?page={_page}&pageSize={_pageSize}");
            if (res != null)
            {
                _orders = res.Items;
                _total = res.Total;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar ventas: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task PaginaAnterior()
    {
        if (_page > 1)
        {
            _page--;
            await CargarOrdenesAsync();
        }
    }

    private async Task PaginaSiguiente()
    {
        if (_page < _totalPages)
        {
            _page++;
            await CargarOrdenesAsync();
        }
    }

    private void VerDetalle(Order order)
    {
        _selectedOrder = order;
        _dialogDetalle = true;
    }

    private void AbrirImpresion(Order order)
    {
        _selectedOrder = order;
        _showReceiptModal = true;
    }

    private async Task PrintReceipt()
    {
        await JS.InvokeVoidAsync("window.print");
    }

    private Color GetOrderTypeColor(string type)
    {
        if (type.Contains("Salon", StringComparison.OrdinalIgnoreCase)) return Color.Info;
        if (type.Contains("Delivery", StringComparison.OrdinalIgnoreCase)) return Color.Warning;
        return Color.Default;
    }
}