@page "/products-admin"
@attribute [Authorize(Roles = "Owner,Admin,Manager,Tester")]
@using RotiseriaWeb.Models
@inject HttpClient Http
@inject ISnackbar Snackbar

<PageTitle>Productos y Carta - SaaS Gastronómico</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-2 mb-8">
    <div class="d-flex flex-wrap justify-space-between align-center mb-6 gap-2">
        <div>
            <MudText Typo="Typo.h4" Style="font-weight: 700; letter-spacing: -0.02em;">Gestión del Menú y Productos</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Administrá platos, precios de venta, control de stock y visibilidad en el punto de venta.</MudText>
        </div>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="/categories" StartIcon="@Icons.Material.Filled.Category" Size="Size.Small">
            Gestionar Categorías
        </MudButton>
    </div>

    @* Formulario rápido para agregar un producto *@
    <div class="mud-paper pa-5 mb-5">
        <div class="d-flex align-center gap-2 mb-3">
            <MudIcon Icon="@Icons.Material.Filled.AddCircle" Color="Color.Primary" Size="Size.Small" />
            <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">Agregar Nuevo Producto a la Carta</MudText>
        </div>

        <MudGrid Class="align-center" Spacing="2">
            <MudItem xs="12" sm="4">
                <MudTextField @bind-Value="_newProduct.Name" Label="Nombre del Producto (Ej: Pizza Muzzarella)" Variant="Variant.Outlined"
                              Margin="Margin.Dense" Required="true" />
            </MudItem>
            <MudItem xs="12" sm="2">
                <MudNumericField @bind-Value="_newProduct.Price" Label="Precio Venta ($)" Variant="Variant.Outlined"
                                 Margin="Margin.Dense" Min="0m" Format="N2" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudSelect T="int?" @bind-Value="_newProduct.CategoryId" Label="Categoría" Variant="Variant.Outlined"
                           Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter">
                    <MudSelectItem T="int?" Value="@((int?)null)">-- Sin Categoría --</MudSelectItem>
                    @foreach (var cat in _categories)
                    {
                        <MudSelectItem T="int?" Value="@((int?)cat.Id)">@cat.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="2">
                <MudNumericField @bind-Value="_newProduct.Stock" Label="Stock Inicial" Variant="Variant.Outlined"
                                 Margin="Margin.Dense" Min="0" />
            </MudItem>
            <MudItem xs="12" sm="1">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="AgregarProducto"
                           Disabled="@(string.IsNullOrWhiteSpace(_newProduct.Name) || _newProduct.Price <= 0 || _saving)"
                           Style="height: 40px;">
                    +
                </MudButton>
            </MudItem>
        </MudGrid>
    </div>

    @* Buscador y filtros *@
    <div class="mud-paper pa-3 mb-4 d-flex align-center gap-2">
        <MudTextField @bind-Value="_searchTerm" Placeholder="Buscar producto por nombre..." Variant="Variant.Outlined"
                      Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      Class="mr-2" Immediate="false" OnKeyUp="@(async (e) => { if (e.Key == "Enter") await CargarProductos(); })" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CargarProductos" Size="Size.Medium">
            Buscar
        </MudButton>
    </div>

    @* Tabla de productos existentes *@
    <div class="mud-paper overflow-hidden">
        <MudTable Items="@_products" T="Product" Dense="true" Hover="true" Elevation="0" Loading="@_loading">
            <HeaderContent>
                <MudTh>Nombre</MudTh>
                <MudTh>Categoría</MudTh>
                <MudTh Style="text-align: right;">Precio</MudTh>
                <MudTh Style="text-align: right;">Stock</MudTh>
                <MudTh>Estado en Menú</MudTh>
                <MudTh Style="text-align: right;">Acciones</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>
                    <span style="font-weight: 600; color: var(--saas-text-primary);">@context.Name</span>
                </MudTd>
                <MudTd>
                    <span class="saas-badge saas-badge-neutral">
                        @(context.Category?.Name ?? "General")
                    </span>
                </MudTd>
                <MudTd Style="text-align: right; font-weight: 700; color: var(--saas-text-primary);">
                    $ @context.Price.ToString("N2")
                </MudTd>
                <MudTd Style="text-align: right;">
                    <span class="saas-badge @(context.Stock <= 5 ? "saas-badge-warning" : "saas-badge-neutral")">
                        @context.Stock
                    </span>
                </MudTd>
                <MudTd>
                    <MudSwitch T="bool" Value="@context.IsActive"
                               ValueChanged="@(async (bool val) => await ToggleEstado(context))" Color="Color.Success"
                               Label="@(context.IsActive ? "Activo" : "Pausado")" />
                </MudTd>
                <MudTd Style="text-align: right;">
                    <MudTooltip Text="Editar Producto">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Default" Size="Size.Small"
                                       OnClick="@(() => AbrirEditar(context))" Style="width: 28px; height: 28px; padding: 2px;" />
                    </MudTooltip>
                    <MudTooltip Text="Eliminar / Desactivar">
                        <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" Size="Size.Small"
                                       OnClick="@(() => EliminarProducto(context))" Style="width: 28px; height: 28px; padding: 2px;" />
                    </MudTooltip>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <div class="pa-8 text-center text-muted">
                    <MudIcon Icon="@Icons.Material.Filled.Fastfood" Size="Size.Large" Color="Color.Secondary" Class="mb-2" />
                    <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">No se encontraron productos registrados</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Comenzá agregando los primeros platos a la carta arriba.</MudText>
                </div>
            </NoRecordsContent>
        </MudTable>
    </div>
</MudContainer>

@* --- VENTANA FLOTANTE PARA EDITAR PRODUCTOS --- *@
<MudDialog @bind-Visible="_isEditDialogOpen" Options="_dialogOptions">
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" />
            <MudText Typo="Typo.subtitle1" Style="font-weight: 700;">Editar Producto</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_editingProduct.Name" Label="Nombre" Required="true" Variant="Variant.Outlined" Class="mb-3" />
        <MudNumericField @bind-Value="_editingProduct.Price" Label="Precio ($)" Required="true" Variant="Variant.Outlined" Class="mb-3" Min="0m" Format="N2" />
        <MudSelect T="int?" @bind-Value="_editingProduct.CategoryId" Label="Categoría" Variant="Variant.Outlined" Class="mb-3" AnchorOrigin="Origin.BottomCenter">
            <MudSelectItem T="int?" Value="@((int?)null)">-- Sin Categoría --</MudSelectItem>
            @foreach (var cat in _categories)
            {
                <MudSelectItem T="int?" Value="@((int?)cat.Id)">@cat.Name</MudSelectItem>
            }
        </MudSelect>
        <MudNumericField @bind-Value="_editingProduct.Stock" Label="Stock" Variant="Variant.Outlined" Class="mb-3" Min="0" />
        <MudSwitch @bind-Value="_editingProduct.IsActive" Color="Color.Success" Label="Producto Activo para venta en POS" />
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="CerrarEdicion">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="GuardarEdicion" Disabled="_saving">
            @(_saving ? "Guardando..." : "Guardar Cambios")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<Product> _products = new();
    private List<Category> _categories = new();
    private ProductWriteRequest _newProduct = new() { IsActive = true, IsAvailable = true };

    private bool _loading = true;
    private bool _saving = false;
    private string _searchTerm = string.Empty;

    private bool _isEditDialogOpen = false;
    private int _editingId = 0;
    private ProductWriteRequest _editingProduct = new();
    private DialogOptions _dialogOptions = new() { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(CargarCategorias(), CargarProductos());
    }

    private async Task CargarCategorias()
    {
        try
        {
            _categories = await Http.GetFromJsonAsync<List<Category>>("api/Categories") ?? new();
            if (_newProduct.CategoryId == null && _categories.Count > 0)
            {
                _newProduct.CategoryId = _categories[0].Id;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar categorías: {ex.Message}", Severity.Error);
        }
    }

    private async Task CargarProductos()
    {
        _loading = true;
        try
        {
            var url = string.IsNullOrWhiteSpace(_searchTerm)
                ? "api/Producto?page=1&pageSize=100"
                : $"api/Producto?page=1&pageSize=100&q={Uri.EscapeDataString(_searchTerm)}";

            var result = await Http.GetFromJsonAsync<PagedResult<Product>>(url);
            _products = result?.Items ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar menú: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task AgregarProducto()
    {
        _saving = true;
        try
        {
            var response = await Http.PostAsJsonAsync("api/Producto", _newProduct);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Producto agregado al menú", Severity.Success);
                _newProduct = new()
                {
                    IsActive = true,
                    IsAvailable = true,
                    CategoryId = _categories.FirstOrDefault()?.Id
                };
                await CargarProductos();
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Error al agregar producto: {err}", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ToggleEstado(Product prod)
    {
        var targetState = !prod.IsActive;
        var request = new ProductWriteRequest
        {
            Name = prod.Name,
            Price = prod.Price,
            CategoryId = prod.CategoryId,
            Stock = prod.Stock,
            IsActive = targetState,
            IsAvailable = prod.IsAvailable
        };

        var response = await Http.PutAsJsonAsync($"api/Producto/{prod.Id}", request);
        if (response.IsSuccessStatusCode)
        {
            prod.IsActive = targetState;
            Snackbar.Add(prod.IsActive ? $"{prod.Name} activado" : $"{prod.Name} pausado", Severity.Info);
        }
        else
        {
            Snackbar.Add("Error al cambiar estado del producto", Severity.Error);
        }
    }

    private void AbrirEditar(Product prod)
    {
        _editingId = prod.Id;
        _editingProduct = new ProductWriteRequest
        {
            Name = prod.Name,
            Price = prod.Price,
            CategoryId = prod.CategoryId,
            Stock = prod.Stock,
            IsActive = prod.IsActive,
            IsAvailable = prod.IsAvailable
        };
        _isEditDialogOpen = true;
    }

    private void CerrarEdicion()
    {
        _isEditDialogOpen = false;
    }

    private async Task GuardarEdicion()
    {
        _saving = true;
        try
        {
            var response = await Http.PutAsJsonAsync($"api/Producto/{_editingId}", _editingProduct);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Producto actualizado", Severity.Success);
                _isEditDialogOpen = false;
                await CargarProductos();
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Error al actualizar: {err}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task EliminarProducto(Product prod)
    {
        var response = await Http.DeleteAsync($"api/Producto/{prod.Id}");
        if (response.IsSuccessStatusCode)
        {
            Snackbar.Add("Producto desactivado", Severity.Success);
            await CargarProductos();
        }
        else
        {
            Snackbar.Add("Error al eliminar", Severity.Error);
        }
    }
}