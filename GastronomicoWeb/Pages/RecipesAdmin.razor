@page "/recetas"
@using RotiseriaWeb.Models
@using RotiseriaWeb.Services
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Recetas y Costeo - SaaS Gastronómico</PageTitle>

<FeatureGate Feature="@FeatureCodes.Recipes"
             FeatureName="Fichas Técnicas y Recetas (BOM)"
             Description="Definí los ingredientes de cada plato para calcular automáticamente el costo de mercadería vendida (CMV), margen de rentabilidad real y descontar insumos con cada venta.">

<MudContainer MaxWidth="MaxWidth.Large" Class="py-2 mb-8">
    <div class="d-flex flex-wrap justify-space-between align-center mb-6 gap-2">
        <div>
            <MudText Typo="Typo.h4" Style="font-weight: 700; letter-spacing: -0.02em;">Recetas y Costeo (CMV)</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Composición técnica de platos, costeo de materias primas y deducción automática de stock.</MudText>
        </div>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadProductsAndSupplies" Size="Size.Small">
            Actualizar
        </MudButton>
    </div>

    <!-- Search filter -->
    <div class="mud-paper pa-3 mb-4">
        <MudTextField @bind-Value="searchString" Placeholder="Buscar producto por nombre..." Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
    </div>

    @if (loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
    }
    else if (!filteredProducts.Any())
    {
        <div class="mud-paper pa-8 text-center text-muted">
            <MudIcon Icon="@Icons.Material.Filled.MenuBook" Size="Size.Large" Color="Color.Secondary" Class="mb-2" />
            <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">No se encontraron productos</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Verificá el filtro de búsqueda.</MudText>
        </div>
    }
    else
    {
        <div class="mud-paper overflow-hidden">
            <MudTable Items="@filteredProducts" Dense="true" Hover="true" Elevation="0">
                <HeaderContent>
                    <MudTh>Producto</MudTh>
                    <MudTh>Categoría</MudTh>
                    <MudTh Style="text-align: right;">Precio de Venta</MudTh>
                    <MudTh Style="text-align: center;">Ficha Técnica</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        <span style="font-weight: 600; color: var(--saas-text-primary);">@context.Name</span>
                    </MudTd>
                    <MudTd>
                        <span class="saas-badge saas-badge-neutral">
                            @(string.IsNullOrWhiteSpace(context.CategoryName) ? "General" : context.CategoryName)
                        </span>
                    </MudTd>
                    <MudTd Style="text-align: right; font-weight: 700; color: var(--saas-text-primary);">
                        $@context.Price.ToString("N2")
                    </MudTd>
                    <MudTd Style="text-align: center;">
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.RestaurantMenu"
                                   OnClick="@(() => OpenRecipeModal(context))">
                            Configurar Receta
                        </MudButton>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </div>
    }

    <!-- Dialog Recipe Configurator -->
    <MudDialog @bind-Visible="recipeDialogVisible" Options="dialogOptions">
        <TitleContent>
            <div class="d-flex align-center gap-2">
                <MudIcon Icon="@Icons.Material.Filled.AutoStories" Size="Size.Small" />
                <MudText Typo="Typo.subtitle1" Style="font-weight: 700;">
                    Receta y Escandallo: <b>@selectedProduct?.Name</b>
                </MudText>
            </div>
        </TitleContent>
        <DialogContent>
            @if (loadingRecipe)
            {
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
            }
            else
            {
                <!-- Margin and cost summary banner -->
                <div class="pa-3 rounded mb-4" style="background-color: var(--saas-surface-subtle); border: 1px solid var(--saas-border);">
                    <MudGrid Spacing="2">
                        <MudItem xs="4">
                            <span class="saas-kpi-label">Precio de Venta</span>
                            <div style="font-size: 1.15rem; font-weight: 700; color: var(--saas-text-primary);">
                                $@(selectedProduct?.Price.ToString("N2") ?? "0.00")
                            </div>
                        </MudItem>
                        <MudItem xs="4">
                            <span class="saas-kpi-label">Costo Insumos</span>
                            <div style="font-size: 1.15rem; font-weight: 700; color: var(--saas-error-text);">
                                $@ComputedTotalCost.ToString("N2")
                            </div>
                        </MudItem>
                        <MudItem xs="4">
                            <span class="saas-kpi-label">Margen Bruto</span>
                            <div>
                                <span class="saas-badge @(ComputedMargin >= 60 ? "saas-badge-success" : (ComputedMargin >= 40 ? "saas-badge-warning" : "saas-badge-error"))"
                                      style="font-size: 0.9rem; font-weight: 700;">
                                    @ComputedMargin.ToString("N1")%
                                </span>
                            </div>
                        </MudItem>
                    </MudGrid>
                </div>

                <!-- Ingredients Table / Inputs -->
                <div class="d-flex justify-space-between align-center mb-3">
                    <MudText Typo="Typo.subtitle2" Style="font-weight: 600;">Ingredientes y Cantidades por Porción</MudText>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Add" OnClick="AddIngredientRow">
                        Agregar Insumo
                    </MudButton>
                </div>

                @if (!recipeRows.Any())
                {
                    <div class="pa-4 text-center rounded my-2" style="background-color: var(--saas-info-bg); border: 1px solid var(--saas-info-border); color: var(--saas-info-text); font-size: 0.875rem;">
                        Este plato no tiene insumos asignados. Agregá materias primas para deducir stock en cada comanda.
                    </div>
                }
                else
                {
                    <div style="max-height: 280px; overflow-y: auto;">
                        @foreach (var (row, index) in recipeRows.Select((r, i) => (r, i)))
                        {
                            var selectedSupply = availableSupplies.FirstOrDefault(s => s.Id == row.SupplyId);
                            var unit = selectedSupply?.Unit ?? "";
                            var unitCost = selectedSupply?.CostPerUnit ?? 0m;
                            var subtotal = row.Quantity * unitCost;

                            <div class="d-flex align-center gap-2 mb-2 pa-2 rounded" style="background: var(--saas-surface); border: 1px solid var(--saas-border);">
                                <div style="flex: 2;">
                                    <MudSelect T="int" @bind-Value="row.SupplyId" Label="Insumo" Margin="Margin.Dense" Variant="Variant.Outlined">
                                        @foreach (var sup in availableSupplies)
                                        {
                                            <MudSelectItem Value="@sup.Id">@sup.Name (@sup.Unit - $@sup.CostPerUnit.ToString("N2"))</MudSelectItem>
                                        }
                                    </MudSelect>
                                </div>
                                <div style="flex: 1;">
                                    <MudNumericField @bind-Value="row.Quantity" Label="@($"Cant ({unit})")" Min="0.001m" Format="N3" Margin="Margin.Dense" Variant="Variant.Outlined" />
                                </div>
                                <div style="flex: 1; text-align: right;">
                                    <span style="font-size: 0.7rem; color: var(--saas-text-secondary); display: block;">Costo</span>
                                    <span style="font-weight: 700; color: var(--saas-text-primary);">$@subtotal.ToString("N2")</span>
                                </div>
                                <div>
                                    <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Small" Color="Color.Error" OnClick="@(() => RemoveIngredientRow(index))" />
                                </div>
                            </div>
                        }
                    </div>
                }
            }
        </DialogContent>
        <DialogActions>
            <MudButton Variant="Variant.Outlined" OnClick="@(() => recipeDialogVisible = false)">Cerrar</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveRecipeAsync" Disabled="savingRecipe">
                @(savingRecipe ? "Guardando..." : "Guardar Receta")
            </MudButton>
        </DialogActions>
    </MudDialog>
</MudContainer>

</FeatureGate>

@code {
    private List<Product> products = new();
    private List<SupplyDto> availableSupplies = new();
    private bool loading = true;
    private string searchString = string.Empty;

    private bool recipeDialogVisible = false;
    private bool loadingRecipe = false;
    private bool savingRecipe = false;
    private Product? selectedProduct;
    private List<RecipeRowModel> recipeRows = new();

    private DialogOptions dialogOptions = new() { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };

    private IEnumerable<Product> filteredProducts => products.Where(p =>
        string.IsNullOrWhiteSpace(searchString) || p.Name.Contains(searchString, StringComparison.OrdinalIgnoreCase));

    private decimal ComputedTotalCost => recipeRows.Sum(r =>
    {
        var sup = availableSupplies.FirstOrDefault(s => s.Id == r.SupplyId);
        return r.Quantity * (sup?.CostPerUnit ?? 0m);
    });

    private decimal ComputedMargin
    {
        get
        {
            if (selectedProduct == null || selectedProduct.Price <= 0) return 0;
            var cost = ComputedTotalCost;
            return ((selectedProduct.Price - cost) / selectedProduct.Price) * 100m;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadProductsAndSupplies();
    }

    private async Task LoadProductsAndSupplies()
    {
        loading = true;
        try
        {
            var pTask = Http.GetFromJsonAsync<List<Product>>("api/products");
            var sTask = Http.GetFromJsonAsync<List<SupplyDto>>("api/supplies");
            await Task.WhenAll(pTask, sTask);

            products = await pTask ?? new();
            availableSupplies = await sTask ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar datos: {ex.Message}", Severity.Error);
        }
        finally
        {
            loading = false;
        }
    }

    private async Task OpenRecipeModal(Product product)
    {
        selectedProduct = product;
        recipeDialogVisible = true;
        loadingRecipe = true;
        recipeRows.Clear();

        try
        {
            var recipe = await Http.GetFromJsonAsync<ProductRecipeDto>($"api/recipes/product/{product.Id}");
            if (recipe != null && recipe.Items.Any())
            {
                recipeRows = recipe.Items.Select(i => new RecipeRowModel
                {
                    SupplyId = i.SupplyId,
                    Quantity = i.Quantity
                }).ToList();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al consultar receta: {ex.Message}", Severity.Error);
        }
        finally
        {
            loadingRecipe = false;
        }
    }

    private void AddIngredientRow()
    {
        if (!availableSupplies.Any())
        {
            Snackbar.Add("Primero debés registrar insumos en la sección de Insumos.", Severity.Warning);
            return;
        }

        recipeRows.Add(new RecipeRowModel
        {
            SupplyId = availableSupplies.First().Id,
            Quantity = 0.1m
        });
    }

    private void RemoveIngredientRow(int index)
    {
        if (index >= 0 && index < recipeRows.Count)
        {
            recipeRows.RemoveAt(index);
        }
    }

    private async Task SaveRecipeAsync()
    {
        if (selectedProduct == null) return;

        savingRecipe = true;
        try
        {
            var req = new SaveRecipeRequest
            {
                Items = recipeRows.Where(r => r.SupplyId > 0 && r.Quantity > 0).Select(r => new RecipeItemInputDto
                {
                    SupplyId = r.SupplyId,
                    Quantity = r.Quantity
                }).ToList()
            };

            var res = await Http.PostAsJsonAsync($"api/recipes/product/{selectedProduct.Id}", req);
            if (res.IsSuccessStatusCode)
            {
                Snackbar.Add("Receta guardada exitosamente", Severity.Success);
                recipeDialogVisible = false;
            }
            else
            {
                var err = await res.Content.ReadAsStringAsync();
                Snackbar.Add($"Error al guardar receta: {err}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            savingRecipe = false;
        }
    }

    private class RecipeRowModel
    {
        public int SupplyId { get; set; }
        public decimal Quantity { get; set; }
    }
}
