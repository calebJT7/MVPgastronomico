@page "/login"
@attribute [AllowAnonymous]
@inject HttpClient Http
@inject JwtAuthenticationStateProvider AuthState
@inject SaaSStateService State
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@using System.Text.Json

<PageTitle>Iniciar Sesión - Gastronómico SaaS</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="d-flex align-center justify-center py-12" Style="min-height: 85vh;">
    <MudCard Elevation="0" Class="pa-8 w-100" Style="border: 1px solid var(--saas-border); border-radius: 16px; background: var(--saas-surface); box-shadow: var(--saas-shadow-sm);">
        <div class="text-center mb-6">
            <div class="mx-auto mb-3" style="width: 48px; height: 48px; border-radius: 12px; background: var(--saas-primary); display: flex; align-items: center; justify-content: center;">
                <MudIcon Icon="@Icons.Material.Filled.Restaurant" Style="color: var(--saas-primary-text); font-size: 24px;" />
            </div>
            <MudText Typo="Typo.h5" Class="font-weight-bold" Style="color: var(--saas-text-primary); letter-spacing: -0.02em;">Iniciar Sesión</MudText>
            <MudText Typo="Typo.body2" Style="color: var(--saas-text-secondary);" Class="mt-1">Ingresá a tu plataforma de gestión gastronómica</MudText>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4 rounded-lg" Dense="true">@errorMessage</MudAlert>
        }

        <EditForm Model="@model" OnValidSubmit="HandleLogin">
            <DataAnnotationsValidator />

            <MudTextField @bind-Value="model.Email" Label="Correo Electrónico" Variant="Variant.Outlined"
                          InputType="InputType.Email" Required="true" RequiredError="El email es obligatorio"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Email" Class="mb-4" />

            <MudTextField @bind-Value="model.Password" Label="Contraseña" Variant="Variant.Outlined"
                          InputType="@(showPassword ? InputType.Text : InputType.Password)" Required="true"
                          RequiredError="La contraseña es obligatoria"
                          Adornment="Adornment.End" AdornmentIcon="@(showPassword ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                          OnAdornmentClick="@(() => showPassword = !showPassword)" Class="mb-4" />

            <div class="d-flex justify-space-between align-center mb-6">
                <MudLink Href="/forgot-password" Typo="Typo.body2" Style="color: var(--saas-text-secondary); font-weight: 500; font-size: 0.85rem;">¿Olvidaste tu clave?</MudLink>
                <MudLink Href="/register" Typo="Typo.body2" Style="color: var(--saas-primary); font-weight: 600; font-size: 0.85rem;">Crear cuenta</MudLink>
            </div>

            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                       FullWidth="true" Size="Size.Large" Class="rounded-lg py-3 font-weight-bold" Disabled="@isSubmitting">
                @if (isSubmitting)
                {
                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                    <MudText Class="ms-2">Iniciando sesión...</MudText>
                }
                else
                {
                    <MudText>Ingresar al Sistema</MudText>
                }
            </MudButton>
        </EditForm>
    </MudCard>
</MudContainer>

@code {
    private LoginRequest model = new();
    private bool showPassword = false;
    private bool isSubmitting = false;
    private string? errorMessage;

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private async Task HandleLogin()
    {
        isSubmitting = true;
        errorMessage = null;

        try
        {
            var response = await Http.PostAsJsonAsync("api/Auth/login", model);
            if (response.IsSuccessStatusCode)
            {
                var auth = await response.Content.ReadFromJsonAsync<AuthResponse>();
                if (auth != null)
                {
                    var businessJson = JsonSerializer.Serialize(auth);
                    State.SetAuthInfo(auth);
                    await AuthState.MarkUserAsAuthenticatedAsync(auth.Token, businessJson);
                    Snackbar.Add($"¡Bienvenido de vuelta!", Severity.Success);

                    var target = !auth.OnboardingCompleted
                        ? "/onboarding"
                        : (!string.IsNullOrWhiteSpace(ReturnUrl) ? ReturnUrl : "/");

                    Nav.NavigateTo(target);
                    return;
                }
            }
            else
            {
                if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
                {
                    errorMessage = "Usuario o contraseña inválidos.";
                }
                else
                {
                    var err = await response.Content.ReadAsStringAsync();
                    errorMessage = !string.IsNullOrWhiteSpace(err)
                        ? err
                        : $"Error de comunicación con la API (HTTP {(int)response.StatusCode} {response.StatusCode}). Verifique que la API esté iniciada.";
                }
            }
            isSubmitting = false;
        }
        catch (Exception ex)
        {
            errorMessage = "Error de conexión con el servidor: " + ex.Message;
            isSubmitting = false;
        }
    }
}
