@page "/cocina"
@using RotiseriaWeb.Models
@using RotiseriaWeb.Services
@using Microsoft.AspNetCore.SignalR.Client
@using System.Timers
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject ILocalStorageService LocalStorage
@inject SaaSStateService SaaSState
@implements IAsyncDisposable

<PageTitle>Monitor de Cocina (KDS) - SaaS Gastronómico</PageTitle>

<FeatureGate Feature="@FeatureCodes.Kds"
             FeatureName="Monitor de Cocina (KDS)"
             Description="El monitor KDS en tiempo real con SignalR para cocina, comandas y alertas de demora está disponible exclusivamente en el Plan Premium.">

<MudContainer MaxWidth="MaxWidth.False" Class="py-2 mb-8">
    <div class="d-flex flex-wrap justify-space-between align-center mb-6 gap-2">
        <div>
            <div class="d-flex align-center gap-2">
                <MudText Typo="Typo.h4" Style="font-weight: 700; letter-spacing: -0.02em;">Monitor de Cocina (KDS)</MudText>
                @if (IsConnected)
                {
                    <span class="saas-badge saas-badge-success" style="font-size: 0.7rem;">● En Línea (SignalR)</span>
                }
                else
                {
                    <span class="saas-badge saas-badge-warning" style="font-size: 0.7rem;">○ Conectando...</span>
                }
            </div>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Comandas en preparación en tiempo real ordenadas por antigüedad de ingreso.
            </MudText>
        </div>
        <div class="d-flex gap-2">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="LoadOrders" StartIcon="@Icons.Material.Filled.Refresh" Size="Size.Small">
                Actualizar
            </MudButton>
        </div>
    </div>

    @if (loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
    }
    else if (!pendingOrders.Any())
    {
        <div class="mud-paper pa-8 text-center my-6">
            <div style="width: 56px; height: 56px; border-radius: 50%; background-color: var(--saas-success-bg); color: var(--saas-success-text); display: flex; align-items: center; justify-content: center; margin: 0 auto 12px auto; border: 1px solid var(--saas-success-border);">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircleOutline" Size="Size.Large" />
            </div>
            <MudText Typo="Typo.h5" Style="font-weight: 700;">¡Cocina al día!</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">No hay comandas pendientes de preparación en este momento.</MudText>
        </div>
    }
    else
    {
        <MudGrid Spacing="3">
            @foreach (var order in pendingOrders)
            {
                var minutosTranscurridos = (int)(DateTime.UtcNow - order.Date).TotalMinutes;
                var showAlert30 = minutosTranscurridos >= 30 && minutosTranscurridos < 45 && !order.Alert30Dismissed;
                var showAlert45 = minutosTranscurridos >= 45;

                string borderTopColor = showAlert45 ? "#ef4444" : (showAlert30 ? "#f59e0b" : "var(--saas-primary)");

                <MudItem xs="12" sm="6" md="4" lg="3">
                    <div class="mud-paper h-100 d-flex flex-column justify-space-between"
                         style="border-top: 4px solid @borderTopColor; background-color: var(--saas-surface);">
                        <div class="pa-4">
                            <div class="d-flex justify-space-between align-start mb-2 gap-1">
                                <div>
                                    <MudText Typo="Typo.subtitle1" Style="font-weight: 700; line-height: 1.2;">
                                        @(string.IsNullOrWhiteSpace(order.ClientName) ? $"Pedido #{order.Id}" : order.ClientName)
                                    </MudText>
                                    <span class="saas-badge saas-badge-neutral mt-1" style="font-size: 0.65rem;">
                                        @order.OrderType
                                    </span>
                                </div>
                                <span class="saas-badge @(showAlert45 ? "saas-badge-error" : (showAlert30 ? "saas-badge-warning" : "saas-badge-info"))" style="font-size: 0.7rem;">
                                    ⏱ Hace @minutosTranscurridos min
                                </span>
                            </div>

                            @if (showAlert45)
                            {
                                <div class="pa-1 px-2 mb-2 rounded text-center" style="background-color: var(--saas-error-bg); border: 1px solid var(--saas-error-border); color: var(--saas-error-text); font-size: 0.7rem; font-weight: 700;">
                                    Demora crítica (+45 min)
                                </div>
                            }

                            <MudDivider Class="my-2" />

                            <div style="max-height: 220px; overflow-y: auto;">
                                <MudList T="string" Dense="true">
                                    @foreach (var item in order.Items)
                                    {
                                        <MudListItem T="string" Class="px-0 py-1">
                                            <div class="d-flex align-center gap-2">
                                                <span style="font-weight: 700; min-width: 24px; color: var(--saas-text-primary);">@item.Quantity x</span>
                                                <span style="font-size: 0.875rem;">@item.ProductName</span>
                                            </div>
                                        </MudListItem>
                                    }
                                </MudList>
                            </div>
                        </div>

                        <div class="pa-3 d-flex justify-space-between gap-2" style="background-color: var(--saas-surface-subtle); border-top: 1px solid var(--saas-border-subtle);">
                            <MudButton Color="Color.Error" Variant="Variant.Outlined" Size="Size.Small"
                                       OnClick="@(() => CancelarPedido(order.Id))">
                                Cancelar
                            </MudButton>

                            <MudButton Color="Color.Success" Variant="Variant.Filled" Size="Size.Small"
                                       OnClick="@(() => MarcarDespachado(order.Id))" StartIcon="@Icons.Material.Filled.Check">
                                Despachar
                            </MudButton>
                        </div>
                    </div>
                </MudItem>
            }
        </MudGrid>
    }
</MudContainer>

</FeatureGate>

@code {
    private List<Order> pendingOrders = new();
    private bool loading = true;
    private Timer? _timer;
    private HubConnection? _hubConnection;

    public bool IsConnected => _hubConnection?.State == HubConnectionState.Connected;

    protected override async Task OnInitializedAsync()
    {
        if (!SaaSState.HasFeature(FeatureCodes.Kds))
        {
            loading = false;
            return;
        }

        await LoadOrders();
        await SetupSignalRAsync();

        _timer = new Timer(60000);
        _timer.Elapsed += async (sender, e) => { await InvokeAsync(StateHasChanged); };
        _timer.Start();
    }

    private async Task SetupSignalRAsync()
    {
        try
        {
            var hubUri = new Uri(Http.BaseAddress ?? new Uri(Navigation.BaseUri), "hubs/orders");
            _hubConnection = new HubConnectionBuilder()
                .WithUrl(hubUri, options =>
                {
                    options.AccessTokenProvider = async () =>
                    {
                        return await LocalStorage.GetItemAsync(JwtAuthenticationStateProvider.TokenKey);
                    };
                })
                .WithAutomaticReconnect()
                .Build();

            _hubConnection.On<object>("OrderUpdated", async (payload) =>
            {
                await LoadOrders();
                await InvokeAsync(StateHasChanged);
            });

            await _hubConnection.StartAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"SignalR error: {ex.Message}");
        }
    }

    private async Task LoadOrders()
    {
        loading = true;
        try
        {
            var orders = await Http.GetFromJsonAsync<List<Order>>("api/Orders/today");
            pendingOrders = orders?.Where(o => o.Status == "Pendiente").OrderBy(o => o.Date).ToList() ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al actualizar comandas: {ex.Message}", Severity.Error);
        }
        finally
        {
            loading = false;
        }
    }

    private async Task MarcarDespachado(int orderId)
    {
        var res = await Http.PatchAsync($"api/Orders/dispatch/{orderId}", null);
        if (res.IsSuccessStatusCode)
        {
            Snackbar.Add("Pedido despachado", Severity.Success);
            await LoadOrders();
        }
        else
        {
            Snackbar.Add("Error al despachar pedido", Severity.Error);
        }
    }

    private async Task CancelarPedido(int orderId)
    {
        var res = await Http.PatchAsync($"api/Orders/cancel/{orderId}", null);
        if (res.IsSuccessStatusCode)
        {
            Snackbar.Add("Pedido cancelado", Severity.Info);
            await LoadOrders();
        }
        else
        {
            Snackbar.Add("Error al cancelar", Severity.Error);
        }
    }

    public async ValueTask DisposeAsync()
    {
        _timer?.Dispose();
        if (_hubConnection != null)
        {
            await _hubConnection.DisposeAsync();
        }
    }
}