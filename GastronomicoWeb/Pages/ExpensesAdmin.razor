@page "/expenses"
@attribute [Authorize(Roles = "Owner,Admin,Manager")]
@inject HttpClient Http
@inject ISnackbar Snackbar

<PageTitle>Gastos Operativos - Gastronómico SaaS</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="my-6">
    <div class="d-flex justify-space-between align-center mb-6">
        <div>
            <MudText Typo="Typo.h4" Color="Color.Primary">Gastos Operativos</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Registro de compras de mercadería, insumos y servicios</MudText>
        </div>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialog">
            Registrar Gasto
        </MudButton>
    </div>

    <MudTable Items="@expenses" Hover="true" Elevation="4" Loading="@loading">
        <HeaderContent>
            <MudTh>Fecha</MudTh>
            <MudTh>Descripción</MudTh>
            <MudTh>Categoría</MudTh>
            <MudTh>Monto</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Fecha">@context.Date.ToString("dd/MM/yyyy HH:mm")</MudTd>
            <MudTd DataLabel="Descripción"><b>@context.Description</b></MudTd>
            <MudTd DataLabel="Categoría">
                <MudChip T="string" Size="Size.Small">@context.Category</MudChip>
            </MudTd>
            <MudTd DataLabel="Monto" Style="color: #f44336; font-weight: bold;">
                $ @context.Amount
            </MudTd>
        </RowTemplate>
    </MudTable>
</MudContainer>

<MudDialog @bind-Visible="dialogOpen" Options="dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">Registrar Nuevo Gasto</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="newExpense.Description" Label="Descripción (Ej: Compra de verdura)" Required="true" Class="mb-3" />
        <MudNumericField @bind-Value="newExpense.Amount" Label="Monto ($)" Min="1" Required="true" Class="mb-3" />
        <MudSelect T="string" @bind-Value="newExpense.Category" Label="Categoría del Gasto" Class="mb-3">
            <MudSelectItem Value="@("Mercadería")">Mercadería / Insumos</MudSelectItem>
            <MudSelectItem Value="@("Servicios")">Servicios (Luz, Gas, Agua, Internet)</MudSelectItem>
            <MudSelectItem Value="@("Mantenimiento")">Mantenimiento y Reparaciones</MudSelectItem>
            <MudSelectItem Value="@("Sueldos")">Adelantos / Sueldos</MudSelectItem>
            <MudSelectItem Value="@("Otros")">Otros Gastos</MudSelectItem>
        </MudSelect>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => dialogOpen = false)">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="SaveExpense"
                   Disabled="@(string.IsNullOrWhiteSpace(newExpense.Description) || newExpense.Amount <= 0)">
            Guardar
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<Expense> expenses = new();
    private bool loading = true;
    private bool dialogOpen = false;
    private Expense newExpense = new() { Category = "Mercadería" };
    private DialogOptions dialogOptions = new() { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };

    protected override async Task OnInitializedAsync()
    {
        await LoadExpenses();
    }

    private async Task LoadExpenses()
    {
        loading = true;
        try
        {
            var res = await Http.GetFromJsonAsync<List<Expense>>("api/Expenses");
            expenses = res ?? new();
        }
        finally
        {
            loading = false;
        }
    }

    private void OpenCreateDialog()
    {
        newExpense = new Expense { Category = "Mercadería", Date = DateTime.UtcNow };
        dialogOpen = true;
    }

    private async Task SaveExpense()
    {
        var res = await Http.PostAsJsonAsync("api/Expenses", newExpense);
        if (res.IsSuccessStatusCode)
        {
            Snackbar.Add("Gasto registrado", Severity.Success);
            dialogOpen = false;
            await LoadExpenses();
        }
        else
        {
            Snackbar.Add("Error al registrar gasto", Severity.Error);
        }
    }
}
