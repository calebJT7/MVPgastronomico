@page "/reportes-avanzados"
@using RotiseriaWeb.Models
@using RotiseriaWeb.Services
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>Reportes Avanzados - SaaS Gastronómico</PageTitle>

<FeatureGate Feature="@FeatureCodes.AdvancedReports"
             FeatureName="Reportes Avanzados y Rentabilidad"
             Description="Analizá el margen de contribución real por plato, comparativa de crecimiento contra periodos anteriores, desglose de ventas por canal comercial y exportación de datos en CSV.">

<MudContainer MaxWidth="MaxWidth.Large" Class="py-2 mb-8">
    <div class="d-flex flex-wrap justify-space-between align-center mb-6 gap-2">
        <div>
            <MudText Typo="Typo.h4" Style="font-weight: 700; letter-spacing: -0.02em;">Reportes Avanzados y Rentabilidad</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Métricas de rentabilidad real por plato, comparativas históricas contra períodos anteriores y desglose por canal de venta.</MudText>
        </div>
        <div class="d-flex gap-2 align-center">
            <MudSelect T="int" @bind-Value="selectedDays" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Style="min-width: 150px;" SelectedValuesChanged="OnPeriodChanged" AnchorOrigin="Origin.BottomCenter">
                <MudSelectItem Value="7">Últimos 7 días</MudSelectItem>
                <MudSelectItem Value="15">Últimos 15 días</MudSelectItem>
                <MudSelectItem Value="30">Últimos 30 días</MudSelectItem>
                <MudSelectItem Value="90">Últimos 90 días</MudSelectItem>
            </MudSelect>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Download" OnClick="ExportCsv" Size="Size.Small">
                Exportar CSV
            </MudButton>
        </div>
    </div>

    @if (loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
    }
    else
    {
        <!-- Growth & Period Comparison Cards -->
        @if (periodData != null)
        {
            <div class="mb-6">
                <div class="mb-3">
                    <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">Comparativa contra Período Anterior (@selectedDays días previos)</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Evolución de ventas, tickets y pedidos</MudText>
                </div>

                <MudGrid Spacing="3">
                    <MudItem xs="12" sm="4">
                        <div class="saas-kpi-card h-100 d-flex flex-column justify-space-between">
                            <div>
                                <div class="d-flex justify-space-between align-start mb-2">
                                    <span class="saas-kpi-label">Facturación Total</span>
                                    <div class="saas-kpi-icon-wrapper" style="background-color: var(--saas-success-bg); color: var(--saas-success-text);">
                                        <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Size="Size.Small" />
                                    </div>
                                </div>
                                <div class="saas-kpi-value">$@periodData.Current.TotalSales.ToString("N2")</div>
                            </div>
                            <div class="mt-2">
                                @if (periodData.Growth.SalesPercentage >= 0)
                                {
                                    <span class="saas-badge saas-badge-success">
                                        ↑ +@periodData.Growth.SalesPercentage% vs previo
                                    </span>
                                }
                                else
                                {
                                    <span class="saas-badge saas-badge-error">
                                        ↓ @periodData.Growth.SalesPercentage% vs previo
                                    </span>
                                }
                            </div>
                        </div>
                    </MudItem>

                    <MudItem xs="12" sm="4">
                        <div class="saas-kpi-card h-100 d-flex flex-column justify-space-between">
                            <div>
                                <div class="d-flex justify-space-between align-start mb-2">
                                    <span class="saas-kpi-label">Volumen de Pedidos</span>
                                    <div class="saas-kpi-icon-wrapper" style="background-color: var(--saas-info-bg); color: var(--saas-info-text);">
                                        <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Size="Size.Small" />
                                    </div>
                                </div>
                                <div class="saas-kpi-value">@periodData.Current.OrdersCount</div>
                            </div>
                            <div class="mt-2 d-flex align-center gap-2">
                                @if (periodData.Growth.OrdersPercentage >= 0)
                                {
                                    <span class="saas-badge saas-badge-success">
                                        ↑ +@periodData.Growth.OrdersPercentage%
                                    </span>
                                }
                                else
                                {
                                    <span class="saas-badge saas-badge-error">
                                        ↓ @periodData.Growth.OrdersPercentage%
                                    </span>
                                }
                                <span style="font-size: 0.75rem; color: var(--saas-text-secondary);">(Previo: @periodData.Previous.OrdersCount)</span>
                            </div>
                        </div>
                    </MudItem>

                    <MudItem xs="12" sm="4">
                        <div class="saas-kpi-card h-100 d-flex flex-column justify-space-between">
                            <div>
                                <div class="d-flex justify-space-between align-start mb-2">
                                    <span class="saas-kpi-label">Ticket Promedio</span>
                                    <div class="saas-kpi-icon-wrapper" style="background-color: var(--saas-warning-bg); color: var(--saas-warning-text);">
                                        <MudIcon Icon="@Icons.Material.Filled.PriceCheck" Size="Size.Small" />
                                    </div>
                                </div>
                                <div class="saas-kpi-value">$@periodData.Current.AverageTicket.ToString("N2")</div>
                            </div>
                            <div class="mt-2 d-flex align-center gap-2">
                                @if (periodData.Growth.AverageTicketPercentage >= 0)
                                {
                                    <span class="saas-badge saas-badge-success">
                                        ↑ +@periodData.Growth.AverageTicketPercentage%
                                    </span>
                                }
                                else
                                {
                                    <span class="saas-badge saas-badge-error">
                                        ↓ @periodData.Growth.AverageTicketPercentage%
                                    </span>
                                }
                                <span style="font-size: 0.75rem; color: var(--saas-text-secondary);">(Previo: $@periodData.Previous.AverageTicket.ToString("N2"))</span>
                            </div>
                        </div>
                    </MudItem>
                </MudGrid>
            </div>
        }

        <!-- Channels Breakdown -->
        <div class="mb-6">
            <div class="mb-3">
                <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">Rendimiento por Canal Comercial</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">Desglose de recaudación entre mostrador, envíos y salón</MudText>
            </div>

            <MudGrid Spacing="3">
                @foreach (var ch in channels)
                {
                    <MudItem xs="12" sm="4">
                        <div class="saas-kpi-card h-100 d-flex flex-column justify-space-between">
                            <div>
                                <div class="d-flex justify-space-between align-center mb-2">
                                    <span style="font-weight: 700; color: var(--saas-text-primary); font-size: 1rem;">@ch.Channel</span>
                                    <span class="saas-badge saas-badge-neutral">@ch.OrdersCount pedidos</span>
                                </div>
                                <div class="saas-kpi-value">$@ch.TotalSales.ToString("N2")</div>
                            </div>
                            <div class="saas-kpi-subtext">
                                Promedio por comanda: <b>$@ch.AverageTicket.ToString("N2")</b>
                            </div>
                        </div>
                    </MudItem>
                }
            </MudGrid>
        </div>

        <!-- Margins and Profitability Table -->
        <div class="mb-6">
            <div class="d-flex flex-wrap justify-space-between align-center mb-3 gap-2">
                <div>
                    <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">Rentabilidad y Costeo por Producto (CMV)</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Margen bruto unitario calculado a partir de las fichas técnicas</MudText>
                </div>
                @if (marginsData != null)
                {
                    <span class="saas-badge saas-badge-success" style="font-size: 0.8125rem;">
                        Margen Promedio Catálogo: @marginsData.Summary.AvgMarginPercentage%
                    </span>
                }
            </div>

            @if (marginsData == null || !marginsData.Items.Any())
            {
                <div class="mud-paper pa-8 text-center text-muted">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">No hay productos registrados para costeo.</MudText>
                </div>
            }
            else
            {
                <div class="mud-paper overflow-hidden">
                    <MudTable Items="@marginsData.Items" Dense="true" Hover="true" Elevation="0">
                        <HeaderContent>
                            <MudTh>Producto</MudTh>
                            <MudTh>Categoría</MudTh>
                            <MudTh Style="text-align: right;">Precio Venta</MudTh>
                            <MudTh Style="text-align: right;">Costo Insumos</MudTh>
                            <MudTh Style="text-align: right;">Ganancia Bruta</MudTh>
                            <MudTh Style="text-align: right;">% Margen</MudTh>
                            <MudTh Style="text-align: center;">Ficha Técnica</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>
                                <span style="font-weight: 600; color: var(--saas-text-primary);">@context.ProductName</span>
                            </MudTd>
                            <MudTd>
                                <span class="saas-badge saas-badge-neutral">@context.CategoryName</span>
                            </MudTd>
                            <MudTd Style="text-align: right; font-weight: 700; color: var(--saas-text-primary);">$@context.Price.ToString("N2")</MudTd>
                            <MudTd Style="text-align: right; color: var(--saas-error-text); font-weight: 600;">$@context.EstimatedCost.ToString("N2")</MudTd>
                            <MudTd Style="text-align: right; font-weight: 700; color: var(--saas-success-text);">$@context.EstimatedProfit.ToString("N2")</MudTd>
                            <MudTd Style="text-align: right;">
                                <span class="saas-badge @(context.MarginPercentage >= 60 ? "saas-badge-success" : (context.MarginPercentage >= 40 ? "saas-badge-warning" : "saas-badge-error"))">
                                    @context.MarginPercentage%
                                </span>
                            </MudTd>
                            <MudTd Style="text-align: center;">
                                @if (context.HasRecipe)
                                {
                                    <span class="saas-badge saas-badge-success">Receta Activa</span>
                                }
                                else
                                {
                                    <span class="saas-badge saas-badge-neutral">Sin Receta</span>
                                }
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </div>
            }
        </div>
    }
</MudContainer>

</FeatureGate>

@code {
    private int selectedDays = 30;
    private bool loading = true;

    private MarginsReportResponse? marginsData;
    private PeriodComparisonResponse? periodData;
    private List<ChannelBreakdownDto> channels = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAllReports();
    }

    private async Task OnPeriodChanged()
    {
        await LoadAllReports();
    }

    private async Task LoadAllReports()
    {
        loading = true;
        try
        {
            var mTask = Http.GetFromJsonAsync<MarginsReportResponse>("api/reports/advanced/margins");
            var pTask = Http.GetFromJsonAsync<PeriodComparisonResponse>($"api/reports/advanced/period-comparison?days={selectedDays}");
            var cTask = Http.GetFromJsonAsync<List<ChannelBreakdownDto>>($"api/reports/advanced/by-channel?days={selectedDays}");

            await Task.WhenAll(mTask, pTask, cTask);

            marginsData = await mTask;
            periodData = await pTask;
            channels = await cTask ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar reportes: {ex.Message}", Severity.Error);
        }
        finally
        {
            loading = false;
        }
    }

    private async Task ExportCsv()
    {
        try
        {
            var url = $"api/reports/advanced/export-csv?days={selectedDays}";
            var response = await Http.GetAsync(url);
            if (response.IsSuccessStatusCode)
            {
                var bytes = await response.Content.ReadAsByteArrayAsync();
                var base64 = Convert.ToBase64String(bytes);
                await JS.InvokeVoidAsync("downloadFileFromBase64", $"ventas_reporte_{selectedDays}dias.csv", "text/csv", base64);
                Snackbar.Add("Reporte CSV descargado con éxito", Severity.Success);
            }
            else
            {
                Snackbar.Add("No se pudo descargar el archivo CSV", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    public class MarginsReportResponse
    {
        public List<MarginItemDto> Items { get; set; } = new();
        public MarginSummaryDto Summary { get; set; } = new();
    }

    public class MarginItemDto
    {
        public int Id { get; set; }
        public string ProductName { get; set; } = string.Empty;
        public string CategoryName { get; set; } = string.Empty;
        public decimal Price { get; set; }
        public decimal EstimatedCost { get; set; }
        public decimal EstimatedProfit { get; set; }
        public decimal MarginPercentage { get; set; }
        public bool HasRecipe { get; set; }
    }

    public class MarginSummaryDto
    {
        public int TotalProducts { get; set; }
        public decimal AvgMarginPercentage { get; set; }
        public decimal TotalCatalogValue { get; set; }
        public decimal TotalEstimatedCost { get; set; }
    }

    public class PeriodComparisonResponse
    {
        public int Days { get; set; }
        public PeriodMetricDto Current { get; set; } = new();
        public PeriodMetricDto Previous { get; set; } = new();
        public GrowthMetricDto Growth { get; set; } = new();
    }

    public class PeriodMetricDto
    {
        public decimal TotalSales { get; set; }
        public int OrdersCount { get; set; }
        public decimal AverageTicket { get; set; }
    }

    public class GrowthMetricDto
    {
        public decimal SalesPercentage { get; set; }
        public decimal OrdersPercentage { get; set; }
        public decimal AverageTicketPercentage { get; set; }
    }

    public class ChannelBreakdownDto
    {
        public string Channel { get; set; } = string.Empty;
        public decimal TotalSales { get; set; }
        public int OrdersCount { get; set; }
        public decimal AverageTicket { get; set; }
    }
}
