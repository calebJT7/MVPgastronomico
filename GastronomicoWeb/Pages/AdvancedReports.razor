@page "/reportes-avanzados"
@using RotiseriaWeb.Models
@using RotiseriaWeb.Services
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>Reportes Avanzados - SaaS Gastronómico</PageTitle>

<FeatureGate Feature="@FeatureCodes.AdvancedReports"
             FeatureName="Reportes Avanzados y Rentabilidad"
             Description="Analizá el margen de contribución real por plato, comparativa de crecimiento contra periodos anteriores, desglose de ventas por canal comercial y exportación de datos en CSV.">

    <div class="d-flex justify-space-between align-center mb-4">
        <div>
            <MudText Typo="Typo.h4" Color="Color.Primary">Reportes Avanzados</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Métricas de rentabilidad, CMV, comparativa entre periodos y canales.</MudText>
        </div>
        <div class="d-flex gap-2">
            <MudSelect T="int" @bind-Value="selectedDays" Label="Periodo" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Style="min-width: 140px;" SelectedValuesChanged="OnPeriodChanged">
                <MudSelectItem Value="7">Últimos 7 días</MudSelectItem>
                <MudSelectItem Value="15">Últimos 15 días</MudSelectItem>
                <MudSelectItem Value="30">Últimos 30 días</MudSelectItem>
                <MudSelectItem Value="90">Últimos 90 días</MudSelectItem>
            </MudSelect>
            <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Download" OnClick="ExportCsv">
                Exportar CSV
            </MudButton>
        </div>
    </div>

    @if (loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
    }
    else
    {
        <!-- Growth & Period Comparison Cards -->
        @if (periodData != null)
        {
            <MudText Typo="Typo.h6" Class="mb-3 font-weight-bold">Comparativa contra el Periodo Anterior (@selectedDays días previos)</MudText>
            <MudGrid Class="mb-6">
                <MudItem xs="12" sm="4">
                    <MudCard Elevation="2" Class="pa-4">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">VENTAS TOTALES (FACTURACIÓN)</MudText>
                        <MudText Typo="Typo.h5" Class="font-weight-bold">$@periodData.Current.TotalSales.ToString("N2")</MudText>
                        <div class="d-flex align-center mt-2">
                            @if (periodData.Growth.SalesPercentage >= 0)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Color="Color.Success" Size="Size.Small" Class="mr-1" />
                                <MudText Typo="Typo.body2" Color="Color.Success"><b>+@periodData.Growth.SalesPercentage%</b> vs periodo anterior</MudText>
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Filled.TrendingDown" Color="Color.Error" Size="Size.Small" Class="mr-1" />
                                <MudText Typo="Typo.body2" Color="Color.Error"><b>@periodData.Growth.SalesPercentage%</b> vs periodo anterior</MudText>
                            }
                        </div>
                    </MudCard>
                </MudItem>

                <MudItem xs="12" sm="4">
                    <MudCard Elevation="2" Class="pa-4">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">CANTIDAD DE PEDIDOS</MudText>
                        <MudText Typo="Typo.h5" Class="font-weight-bold">@periodData.Current.OrdersCount comandas</MudText>
                        <div class="d-flex align-center mt-2">
                            @if (periodData.Growth.OrdersPercentage >= 0)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Color="Color.Success" Size="Size.Small" Class="mr-1" />
                                <MudText Typo="Typo.body2" Color="Color.Success"><b>+@periodData.Growth.OrdersPercentage%</b></MudText>
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Filled.TrendingDown" Color="Color.Error" Size="Size.Small" Class="mr-1" />
                                <MudText Typo="Typo.body2" Color="Color.Error"><b>@periodData.Growth.OrdersPercentage%</b></MudText>
                            }
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="ml-1">(Previo: @periodData.Previous.OrdersCount)</MudText>
                        </div>
                    </MudCard>
                </MudItem>

                <MudItem xs="12" sm="4">
                    <MudCard Elevation="2" Class="pa-4">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">TICKET PROMEDIO</MudText>
                        <MudText Typo="Typo.h5" Class="font-weight-bold">$@periodData.Current.AverageTicket.ToString("N2")</MudText>
                        <div class="d-flex align-center mt-2">
                            @if (periodData.Growth.AverageTicketPercentage >= 0)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Color="Color.Success" Size="Size.Small" Class="mr-1" />
                                <MudText Typo="Typo.body2" Color="Color.Success"><b>+@periodData.Growth.AverageTicketPercentage%</b></MudText>
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Filled.TrendingDown" Color="Color.Error" Size="Size.Small" Class="mr-1" />
                                <MudText Typo="Typo.body2" Color="Color.Error"><b>@periodData.Growth.AverageTicketPercentage%</b></MudText>
                            }
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="ml-1">(Previo: $@periodData.Previous.AverageTicket.ToString("N2"))</MudText>
                        </div>
                    </MudCard>
                </MudItem>
            </MudGrid>
        }

        <!-- Channels Breakdown -->
        <MudText Typo="Typo.h6" Class="mb-3 font-weight-bold">Rendimiento por Canal Comercial</MudText>
        <MudGrid Class="mb-6">
            @foreach (var ch in channels)
            {
                <MudItem xs="12" sm="4">
                    <MudCard Elevation="2" Class="pa-4">
                        <div class="d-flex justify-space-between align-center mb-2">
                            <MudText Typo="Typo.h6">@ch.Channel</MudText>
                            <MudChip T="string" Color="Color.Primary" Size="Size.Small">@ch.OrdersCount pedidos</MudChip>
                        </div>
                        <MudText Typo="Typo.h4" Color="Color.Primary" Class="font-weight-bold mb-1">$@ch.TotalSales.ToString("N2")</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Ticket promedio por venta: $@ch.AverageTicket.ToString("N2")</MudText>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>

        <!-- Margins and Profitability Table -->
        <div class="d-flex justify-space-between align-center mb-3">
            <MudText Typo="Typo.h6" Class="font-weight-bold">Rentabilidad por Producto (Costeo Escandallo)</MudText>
            @if (marginsData != null)
            {
                <MudChip T="string" Color="Color.Success" Size="Size.Small">Margen Promedio Catálogo: @marginsData.Summary.AvgMarginPercentage%</MudChip>
            }
        </div>

        @if (marginsData == null || !marginsData.Items.Any())
        {
            <MudPaper Class="pa-4 text-center">
                <MudText Typo="Typo.body2" Color="Color.Secondary">No hay productos registrados para costeo.</MudText>
            </MudPaper>
        }
        else
        {
            <MudTable Items="@marginsData.Items" Dense="true" Hover="true" Striped="true" Elevation="2">
                <HeaderContent>
                    <MudTh>Producto</MudTh>
                    <MudTh>Categoría</MudTh>
                    <MudTh Style="text-align: right;">Precio Venta</MudTh>
                    <MudTh Style="text-align: right;">Costo Ingredientes</MudTh>
                    <MudTh Style="text-align: right;">Ganancia Bruta</MudTh>
                    <MudTh Style="text-align: right;">% Margen</MudTh>
                    <MudTh Style="text-align: center;">Ficha Técnica</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd><b>@context.ProductName</b></MudTd>
                    <MudTd>@context.CategoryName</MudTd>
                    <MudTd Style="text-align: right; font-weight: bold;">$@context.Price.ToString("N2")</MudTd>
                    <MudTd Style="text-align: right; color: var(--mud-palette-error);">$@context.EstimatedCost.ToString("N2")</MudTd>
                    <MudTd Style="text-align: right; font-weight: bold; color: var(--mud-palette-success);">$@context.EstimatedProfit.ToString("N2")</MudTd>
                    <MudTd Style="text-align: right;">
                        <span style="font-weight: bold; color: @(context.MarginPercentage >= 60 ? "green" : (context.MarginPercentage >= 40 ? "orange" : "red"));">
                            @context.MarginPercentage%
                        </span>
                    </MudTd>
                    <MudTd Style="text-align: center;">
                        @if (context.HasRecipe)
                        {
                            <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Outlined">Receta Activa</MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Color="Color.Default" Size="Size.Small" Variant="Variant.Outlined">Sin Receta</MudChip>
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    }

</FeatureGate>

@code {
    private int selectedDays = 30;
    private bool loading = true;

    private MarginsReportResponse? marginsData;
    private PeriodComparisonResponse? periodData;
    private List<ChannelBreakdownDto> channels = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAllReports();
    }

    private async Task OnPeriodChanged()
    {
        await LoadAllReports();
    }

    private async Task LoadAllReports()
    {
        loading = true;
        try
        {
            var mTask = Http.GetFromJsonAsync<MarginsReportResponse>("api/reports/advanced/margins");
            var pTask = Http.GetFromJsonAsync<PeriodComparisonResponse>($"api/reports/advanced/period-comparison?days={selectedDays}");
            var cTask = Http.GetFromJsonAsync<List<ChannelBreakdownDto>>($"api/reports/advanced/by-channel?days={selectedDays}");

            await Task.WhenAll(mTask, pTask, cTask);

            marginsData = await mTask;
            periodData = await pTask;
            channels = await cTask ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar reportes: {ex.Message}", Severity.Error);
        }
        finally
        {
            loading = false;
        }
    }

    private async Task ExportCsv()
    {
        try
        {
            var url = $"api/reports/advanced/export-csv?days={selectedDays}";
            var response = await Http.GetAsync(url);
            if (response.IsSuccessStatusCode)
            {
                var bytes = await response.Content.ReadAsByteArrayAsync();
                var base64 = Convert.ToBase64String(bytes);
                await JS.InvokeVoidAsync("downloadFileFromBase64", $"ventas_reporte_{selectedDays}dias.csv", "text/csv", base64);
                Snackbar.Add("Reporte CSV descargado con éxito", Severity.Success);
            }
            else
            {
                Snackbar.Add("No se pudo descargar el archivo CSV", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    public class MarginsReportResponse
    {
        public List<MarginItemDto> Items { get; set; } = new();
        public MarginSummaryDto Summary { get; set; } = new();
    }

    public class MarginItemDto
    {
        public int Id { get; set; }
        public string ProductName { get; set; } = string.Empty;
        public string CategoryName { get; set; } = string.Empty;
        public decimal Price { get; set; }
        public decimal EstimatedCost { get; set; }
        public decimal EstimatedProfit { get; set; }
        public decimal MarginPercentage { get; set; }
        public bool HasRecipe { get; set; }
    }

    public class MarginSummaryDto
    {
        public int TotalProducts { get; set; }
        public decimal AvgMarginPercentage { get; set; }
        public decimal TotalCatalogValue { get; set; }
        public decimal TotalEstimatedCost { get; set; }
    }

    public class PeriodComparisonResponse
    {
        public int Days { get; set; }
        public PeriodMetricDto Current { get; set; } = new();
        public PeriodMetricDto Previous { get; set; } = new();
        public GrowthMetricDto Growth { get; set; } = new();
    }

    public class PeriodMetricDto
    {
        public decimal TotalSales { get; set; }
        public int OrdersCount { get; set; }
        public decimal AverageTicket { get; set; }
    }

    public class GrowthMetricDto
    {
        public decimal SalesPercentage { get; set; }
        public decimal OrdersPercentage { get; set; }
        public decimal AverageTicketPercentage { get; set; }
    }

    public class ChannelBreakdownDto
    {
        public string Channel { get; set; } = string.Empty;
        public decimal TotalSales { get; set; }
        public int OrdersCount { get; set; }
        public decimal AverageTicket { get; set; }
    }
}
