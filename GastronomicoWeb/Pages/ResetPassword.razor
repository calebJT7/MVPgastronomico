@page "/reset-password"
@attribute [AllowAnonymous]
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>Restablecer Contraseña - Gastronómico SaaS</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="d-flex align-center justify-center py-12" Style="min-height: 80vh;">
    <MudCard Elevation="0" Class="pa-8 w-100" Style="border: 1px solid var(--saas-border); border-radius: 16px; background: var(--saas-surface); box-shadow: var(--saas-shadow-sm);">
        <div class="text-center mb-6">
            <div class="mx-auto mb-3" style="width: 48px; height: 48px; border-radius: 12px; background: var(--saas-primary); display: flex; align-items: center; justify-content: center;">
                <MudIcon Icon="@Icons.Material.Filled.Password" Style="color: var(--saas-primary-text); font-size: 24px;" />
            </div>
            <MudText Typo="Typo.h5" Class="font-weight-bold" Style="color: var(--saas-text-primary); letter-spacing: -0.02em;">Nueva Contraseña</MudText>
            <MudText Typo="Typo.body2" Style="color: var(--saas-text-secondary);" Class="mt-1">Ingresá tu nueva clave de acceso</MudText>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4 rounded-lg" Dense="true">@errorMessage</MudAlert>
        }

        <EditForm Model="@model" OnValidSubmit="HandleSubmit">
            <MudTextField @bind-Value="model.NewPassword" Label="Nueva Contraseña (mínimo 8 caracteres)"
                          Variant="Variant.Outlined" InputType="InputType.Password" Required="true"
                          RequiredError="La contraseña es obligatoria" Class="mb-3" />

            <MudTextField @bind-Value="confirmPassword" Label="Confirmar Contraseña"
                          Variant="Variant.Outlined" InputType="InputType.Password" Required="true" Class="mb-4" />

            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                       FullWidth="true" Size="Size.Large" Class="rounded-lg py-3 font-weight-bold" Disabled="@isSubmitting">
                @if (isSubmitting)
                {
                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                    <MudText Class="ms-2">Guardando nueva contraseña...</MudText>
                }
                else
                {
                    <MudText>Actualizar Contraseña</MudText>
                }
            </MudButton>
        </EditForm>
    </MudCard>
</MudContainer>

@code {
    private ResetPasswordRequest model = new();
    private string confirmPassword = "";
    private bool isSubmitting = false;
    private string? errorMessage;

    [SupplyParameterFromQuery]
    public string? Token { get; set; }

    protected override void OnInitialized()
    {
        if (!string.IsNullOrWhiteSpace(Token))
            model.Token = Token;
    }

    private async Task HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(model.Token))
        {
            errorMessage = "Token de recuperación no válido o ausente.";
            return;
        }

        if (model.NewPassword.Length < 8)
        {
            errorMessage = "La contraseña debe tener al menos 8 caracteres.";
            return;
        }

        if (model.NewPassword != confirmPassword)
        {
            errorMessage = "Las contraseñas no coinciden.";
            return;
        }

        isSubmitting = true;
        errorMessage = null;

        try
        {
            var res = await Http.PostAsJsonAsync("api/Auth/reset-password", model);
            if (res.IsSuccessStatusCode)
            {
                Snackbar.Add("¡Contraseña actualizada exitosamente! Ya podés ingresar.", Severity.Success);
                Nav.NavigateTo("/login");
            }
            else
            {
                errorMessage = await res.Content.ReadAsStringAsync();
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Error al restablecer contraseña: " + ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
