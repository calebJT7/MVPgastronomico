@page "/customers"
@using RotiseriaWeb.Models
@inject HttpClient Http
@inject ISnackbar Snackbar

<PageTitle>Clientes y Fiados - SaaS Gastronómico</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-2 mb-8">
    <div class="d-flex flex-wrap justify-space-between align-center mb-6 gap-2">
        <div>
            <MudText Typo="Typo.h4" Style="font-weight: 700; letter-spacing: -0.02em;">Gestión de Clientes y Cuentas Corrientes</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Registro de clientes habituales, datos de contacto y seguimiento de saldos y fiados.</MudText>
        </div>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="OpenNewDialog" Size="Size.Small">
            Nuevo Cliente
        </MudButton>
    </div>

    <!-- Filter Bar -->
    <div class="mud-paper pa-3 mb-4 d-flex flex-wrap justify-space-between align-center gap-3">
        <div class="d-flex align-center gap-2">
            <MudSwitch @bind-Value="onlyDebtors" Label="Ver únicamente clientes con saldo deudor (fiados)" Color="Color.Error" />
        </div>
        <div class="d-flex gap-2">
            <span class="saas-badge saas-badge-neutral">
                @displayedCustomers.Count() clientes listados
            </span>
            @if (customers.Any(c => c.Balance < 0))
            {
                <span class="saas-badge saas-badge-error">
                    Deuda total: $ @Math.Abs(customers.Where(c => c.Balance < 0).Sum(c => c.Balance)).ToString("N2")
                </span>
            }
        </div>
    </div>

    <!-- Customer Table -->
    <div class="mud-paper overflow-hidden">
        <MudTable Items="@displayedCustomers" T="RotiseriaWeb.Models.Customer" Hover="true" Elevation="0" Loading="@loading">
            <HeaderContent>
                <MudTh>Nombre / Razón Social</MudTh>
                <MudTh>Teléfono / Contacto</MudTh>
                <MudTh Style="text-align: right;">Estado de Cuenta / Saldo</MudTh>
                <MudTh Style="text-align: right;">Acciones</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Nombre">
                    <div class="d-flex align-center gap-2">
                        <div style="width: 32px; height: 32px; border-radius: 50%; background-color: var(--saas-surface-subtle); color: var(--saas-text-secondary); display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.75rem; border: 1px solid var(--saas-border);">
                            @(context.Name.Length > 0 ? context.Name[0].ToString().ToUpperInvariant() : "C")
                        </div>
                        <span style="font-weight: 600; color: var(--saas-text-primary);">@context.Name</span>
                    </div>
                </MudTd>
                <MudTd DataLabel="Teléfono">
                    @(string.IsNullOrWhiteSpace(context.Phone) ? "-" : context.Phone)
                </MudTd>
                <MudTd DataLabel="Saldo" Style="text-align: right;">
                    @if (context.Balance < 0)
                    {
                        <span class="saas-badge saas-badge-error" style="font-size: 0.8125rem; font-weight: 700;">
                            Debe $ @Math.Abs(context.Balance).ToString("N2")
                        </span>
                    }
                    else if (context.Balance > 0)
                    {
                        <span class="saas-badge saas-badge-success" style="font-size: 0.8125rem; font-weight: 700;">
                            A favor $ @context.Balance.ToString("N2")
                        </span>
                    }
                    else
                    {
                        <span class="saas-badge saas-badge-neutral" style="font-size: 0.8125rem;">
                            Al día ($ 0.00)
                        </span>
                    }
                </MudTd>
                <MudTd DataLabel="Acciones" Style="text-align: right;">
                    <MudTooltip Text="Editar Cliente">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Default" Size="Size.Small"
                                       OnClick="@(() => OpenEditDialog(context))" Style="width: 28px; height: 28px; padding: 2px;" />
                    </MudTooltip>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <div class="pa-8 text-center text-muted">
                    <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Large" Color="Color.Secondary" Class="mb-2" />
                    <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">No hay clientes para mostrar</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Podés dar de alta un nuevo cliente haciendo clic en el botón superior.</MudText>
                </div>
            </NoRecordsContent>
        </MudTable>
    </div>
</MudContainer>

@* --- VENTANA FLOTANTE PARA CREAR O EDITAR --- *@
<MudDialog @bind-Visible="isDialogOpen" Options="dialogOptions">
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" />
            <MudText Typo="Typo.subtitle1" Style="font-weight: 700;">
                @(isEditing ? "Editar Cliente" : "Nuevo Cliente")
            </MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="currentCustomer.Name" Label="Nombre y Apellido / Razón Social" Required="true"
                      Variant="Variant.Outlined" RequiredError="El nombre es obligatorio" Class="mb-3" />
        <MudTextField @bind-Value="currentCustomer.Phone" Label="Teléfono de Contacto" Variant="Variant.Outlined" Class="mb-3" />
        <MudNumericField @bind-Value="currentCustomer.Balance" Label="Saldo Inicial (Deuda con signo negativo, ej: -5000)"
                         Variant="Variant.Outlined" Format="N2" HelperText="Importe negativo representa deuda fiada del cliente" />
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="CloseDialog">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveCustomer">
            Guardar
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<RotiseriaWeb.Models.Customer> customers = new();
    private bool loading = true;
    private bool onlyDebtors = false;

    private bool isDialogOpen = false;
    private bool isEditing = false;
    private RotiseriaWeb.Models.Customer currentCustomer = new();
    private DialogOptions dialogOptions = new() { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };

    private IEnumerable<RotiseriaWeb.Models.Customer> displayedCustomers => onlyDebtors
        ? customers.Where(c => c.Balance < 0)
        : customers;

    protected override async Task OnInitializedAsync()
    {
        await LoadCustomers();
    }

    private async Task LoadCustomers()
    {
        loading = true;
        try
        {
            var result = await Http.GetFromJsonAsync<List<RotiseriaWeb.Models.Customer>>("api/Customer");
            customers = result ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
            Snackbar.Add("No se pudo conectar con la API", Severity.Error);
        }
        finally
        {
            loading = false;
        }
    }

    private void OpenNewDialog()
    {
        isEditing = false;
        currentCustomer = new RotiseriaWeb.Models.Customer();
        isDialogOpen = true;
    }

    private void OpenEditDialog(RotiseriaWeb.Models.Customer customer)
    {
        isEditing = true;
        currentCustomer = new RotiseriaWeb.Models.Customer
        {
            Id = customer.Id,
            Name = customer.Name,
            Phone = customer.Phone,
            Balance = customer.Balance
        };
        isDialogOpen = true;
    }

    private void CloseDialog()
    {
        isDialogOpen = false;
    }

    private async Task SaveCustomer()
    {
        if (string.IsNullOrWhiteSpace(currentCustomer.Name))
        {
            Snackbar.Add("El nombre es obligatorio", Severity.Warning);
            return;
        }

        try
        {
            HttpResponseMessage response;
            if (isEditing)
            {
                response = await Http.PutAsJsonAsync($"api/Customer/{currentCustomer.Id}", currentCustomer);
            }
            else
            {
                response = await Http.PostAsJsonAsync("api/Customer", currentCustomer);
            }

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add(isEditing ? "Cliente actualizado" : "Cliente creado", Severity.Success);
                isDialogOpen = false;
                await LoadCustomers();
            }
            else
            {
                Snackbar.Add("Error al guardar en la base de datos", Severity.Error);
            }
        }
        catch (Exception)
        {
            Snackbar.Add("Error de conexión al guardar", Severity.Error);
        }
    }
}