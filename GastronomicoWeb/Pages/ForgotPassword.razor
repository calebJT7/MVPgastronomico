@page "/forgot-password"
@attribute [AllowAnonymous]
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>Recuperar Contraseña - Gastronómico SaaS</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="d-flex align-center justify-center py-12" Style="min-height: 80vh;">
    <MudCard Elevation="0" Class="pa-8 w-100" Style="border: 1px solid var(--saas-border); border-radius: 16px; background: var(--saas-surface); box-shadow: var(--saas-shadow-sm);">
        <div class="text-center mb-6">
            <div class="mx-auto mb-3" style="width: 48px; height: 48px; border-radius: 12px; background: var(--saas-primary); display: flex; align-items: center; justify-content: center;">
                <MudIcon Icon="@Icons.Material.Filled.LockReset" Style="color: var(--saas-primary-text); font-size: 24px;" />
            </div>
            <MudText Typo="Typo.h5" Class="font-weight-bold" Style="color: var(--saas-text-primary); letter-spacing: -0.02em;">Recuperar Contraseña</MudText>
            <MudText Typo="Typo.body2" Style="color: var(--saas-text-secondary);" Class="mt-1">Ingresá tu correo para enviarte las instrucciones</MudText>
        </div>

        @if (submitted)
        {
            <div class="pa-4 rounded-xl mb-6 text-center" style="background: var(--saas-success-bg); border: 1px solid var(--saas-success-border);">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Style="color: var(--saas-success-text); font-size: 32px;" Class="mb-2" />
                <MudText Typo="Typo.body2" Style="color: var(--saas-success-text); line-height: 1.5;">
                    Si el correo está registrado en el sistema, recibirás un enlace con instrucciones para restablecer tu contraseña.
                </MudText>
            </div>
            <MudButton Variant="Variant.Outlined" Color="Color.Default" FullWidth="true" Href="/login" Class="rounded-lg py-2">
                Volver al Inicio de Sesión
            </MudButton>
        }
        else
        {
            <EditForm Model="@model" OnValidSubmit="HandleSubmit">
                <MudTextField @bind-Value="model.Email" Label="Correo Electrónico" Variant="Variant.Outlined"
                              InputType="InputType.Email" Required="true" RequiredError="El email es requerido"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Email" Class="mb-4" />

                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                           FullWidth="true" Size="Size.Large" Class="rounded-lg py-3 font-weight-bold" Disabled="@isSubmitting">
                    @if (isSubmitting)
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                        <MudText Class="ms-2">Enviando instrucciones...</MudText>
                    }
                    else
                    {
                        <MudText>Enviar Enlace de Recuperación</MudText>
                    }
                </MudButton>

                <div class="text-center mt-5">
                    <MudLink Href="/login" Style="color: var(--saas-text-secondary); font-size: 0.875rem;">Volver al inicio de sesión</MudLink>
                </div>
            </EditForm>
        }
    </MudCard>
</MudContainer>

@code {
    private ForgotPasswordRequest model = new();
    private bool isSubmitting = false;
    private bool submitted = false;

    private async Task HandleSubmit()
    {
        isSubmitting = true;
        try
        {
            await Http.PostAsJsonAsync("api/Auth/forgot-password", model);
            submitted = true;
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error al procesar la solicitud: " + ex.Message, Severity.Error);
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
