@page "/forgot-password"
@attribute [AllowAnonymous]
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>Recuperar Contraseña - Gastronómico SaaS</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center justify-center" Style="min-height: 80vh;">
    <MudPaper Elevation="6" Class="pa-8 rounded-lg w-100" Style="background-color: var(--mud-palette-surface);">
        <div class="text-center mb-6">
            <MudIcon Icon="@Icons.Material.Filled.LockReset" Color="Color.Primary" Style="font-size: 3rem;" />
            <MudText Typo="Typo.h4" Class="mt-2 font-weight-bold">Recuperar Contraseña</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Ingresá tu correo electrónico para enviarte las instrucciones</MudText>
        </div>

        @if (submitted)
        {
            <MudAlert Severity="Severity.Success" Class="mb-6">
                Si el correo está registrado, recibirás un enlace con instrucciones para restablecer tu contraseña.
            </MudAlert>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true" Href="/login">
                Volver a Iniciar Sesión
            </MudButton>
        }
        else
        {
            <EditForm Model="@model" OnValidSubmit="HandleSubmit">
                <MudTextField @bind-Value="model.Email" Label="Correo Electrónico" Variant="Variant.Outlined"
                              InputType="InputType.Email" Required="true" RequiredError="El email es requerido"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Email" Class="mb-4" />

                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                           FullWidth="true" Size="Size.Large" Disabled="@isSubmitting">
                    @if (isSubmitting)
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                        <MudText Class="ms-2">Enviando instrucciones...</MudText>
                    }
                    else
                    {
                        <MudText>Enviar Enlace de Recuperación</MudText>
                    }
                </MudButton>

                <div class="text-center mt-4">
                    <MudLink Href="/login" Color="Color.Secondary">Volver al inicio de sesión</MudLink>
                </div>
            </EditForm>
        }
    </MudPaper>
</MudContainer>

@code {
    private ForgotPasswordRequest model = new();
    private bool isSubmitting = false;
    private bool submitted = false;

    private async Task HandleSubmit()
    {
        isSubmitting = true;
        try
        {
            await Http.PostAsJsonAsync("api/Auth/forgot-password", model);
            submitted = true;
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error al procesar la solicitud: " + ex.Message, Severity.Error);
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
