@page "/caja"
@using RotiseriaWeb.Models
@using RotiseriaWeb.Services
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Caja y Turnos - SaaS Gastronómico</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-2 mb-8">
    <div class="d-flex flex-wrap justify-space-between align-center mb-6 gap-2">
        <div>
            <MudText Typo="Typo.h4" Style="font-weight: 700; letter-spacing: -0.02em;">Caja y Arqueos</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Gestión de aperturas, control de efectivo en mano, ingresos, retiros y arqueo de cierre.</MudText>
        </div>
        <div class="d-flex gap-2">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadCurrentShift" Size="Size.Small">
                Actualizar Caja
            </MudButton>
        </div>
    </div>

    @if (loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
    }
    else
    {
        <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" Class="mud-paper mb-6">
            <MudTabPanel Text="Turno Actual" Icon="@Icons.Material.Filled.PointOfSale" Class="pa-4">
                @if (currentShift == null || !currentShift.IsOpen)
                {
                    <div class="mud-paper pa-8 max-w-md mx-auto my-8 text-center" style="max-width: 480px; margin: 0 auto; border: 1px solid var(--saas-border);">
                        <div style="width: 56px; height: 56px; border-radius: 50%; background-color: var(--saas-surface-subtle); color: var(--saas-text-secondary); display: flex; align-items: center; justify-content: center; margin: 0 auto 16px auto; border: 1px solid var(--saas-border);">
                            <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Large" />
                        </div>
                        <MudText Typo="Typo.h5" Style="font-weight: 700; margin-bottom: 8px;">Caja Cerrada</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-6">
                            Para comenzar a operar y registrar ventas en salón, mostrador o delivery, debés abrir un nuevo turno de caja.
                        </MudText>

                        <div class="text-left mb-4">
                            <MudNumericField @bind-Value="openModel.InitialCash" Label="Fondo Inicial de Caja ($)" Variant="Variant.Outlined" Min="0m" Format="N2" Class="mb-3" />
                            <MudTextField @bind-Value="openModel.Notes" Label="Observaciones de Apertura (Opcional)" Variant="Variant.Outlined" Lines="2" Class="mb-4" />
                        </div>

                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" FullWidth="true"
                                   StartIcon="@Icons.Material.Filled.LockOpen" OnClick="OpenShiftAsync" Disabled="saving">
                            @(saving ? "Abriendo caja..." : "Abrir Turno de Caja")
                        </MudButton>
                    </div>
                }
                else
                {
                    <!-- Shift is Open -->
                    <div class="pa-4 mb-4 rounded d-flex flex-wrap justify-space-between align-center gap-2"
                         style="background-color: var(--saas-success-bg); border: 1px solid var(--saas-success-border); color: var(--saas-success-text);">
                        <div class="d-flex align-center gap-2">
                            <span class="saas-badge saas-badge-success">● TURNO ABIERTO</span>
                            <span style="font-size: 0.875rem;">
                                Responsable: <b>@currentShift.UserName</b> | Apertura: <b>@currentShift.OpenedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</b>
                                @if (!string.IsNullOrWhiteSpace(currentShift.Notes))
                                {
                                    <span> - <i>@currentShift.Notes</i></span>
                                }
                            </span>
                        </div>
                    </div>

                    <!-- Financial Metrics Grid -->
                    <MudGrid Spacing="3" Class="mb-4">
                        <MudItem xs="12" sm="6" md="3">
                            <div class="saas-kpi-card h-100 d-flex flex-column justify-space-between">
                                <div>
                                    <div class="d-flex justify-space-between align-start mb-2">
                                        <span class="saas-kpi-label">Fondo Inicial</span>
                                        <div class="saas-kpi-icon-wrapper">
                                            <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" Size="Size.Small" />
                                        </div>
                                    </div>
                                    <div class="saas-kpi-value">$@currentShift.InitialCash.ToString("N2")</div>
                                </div>
                                <div class="saas-kpi-subtext">Base de cambio en apertura</div>
                            </div>
                        </MudItem>

                        <MudItem xs="12" sm="6" md="3">
                            <div class="saas-kpi-card h-100 d-flex flex-column justify-space-between">
                                <div>
                                    <div class="d-flex justify-space-between align-start mb-2">
                                        <span class="saas-kpi-label">Ventas Efectivo</span>
                                        <div class="saas-kpi-icon-wrapper" style="background-color: var(--saas-success-bg); color: var(--saas-success-text);">
                                            <MudIcon Icon="@Icons.Material.Filled.AttachMoney" Size="Size.Small" />
                                        </div>
                                    </div>
                                    <div class="saas-kpi-value" style="color: var(--saas-success-text);">+$@currentShift.TotalCashSales.ToString("N2")</div>
                                </div>
                                <div class="saas-kpi-subtext">Ingresado por cobros de contado</div>
                            </div>
                        </MudItem>

                        <MudItem xs="12" sm="6" md="3">
                            <div class="saas-kpi-card h-100 d-flex flex-column justify-space-between">
                                <div>
                                    <div class="d-flex justify-space-between align-start mb-2">
                                        <span class="saas-kpi-label">Ventas Electrónicas</span>
                                        <div class="saas-kpi-icon-wrapper" style="background-color: var(--saas-info-bg); color: var(--saas-info-text);">
                                            <MudIcon Icon="@Icons.Material.Filled.CreditCard" Size="Size.Small" />
                                        </div>
                                    </div>
                                    <div class="saas-kpi-value">$@((currentShift.TotalCardSales + currentShift.TotalTransferSales + currentShift.TotalOtherSales).ToString("N2"))</div>
                                </div>
                                <div class="saas-kpi-subtext">
                                    Tarjeta: $@currentShift.TotalCardSales.ToString("N2") | Transf: $@currentShift.TotalTransferSales.ToString("N2")
                                </div>
                            </div>
                        </MudItem>

                        <MudItem xs="12" sm="6" md="3">
                            <div class="saas-kpi-card h-100 d-flex flex-column justify-space-between" style="border-left: 4px solid var(--saas-primary);">
                                <div>
                                    <div class="d-flex justify-space-between align-start mb-2">
                                        <span class="saas-kpi-label">Efectivo Teórico</span>
                                        <div class="saas-kpi-icon-wrapper" style="background-color: var(--saas-primary); color: var(--saas-primary-text);">
                                            <MudIcon Icon="@Icons.Material.Filled.Savings" Size="Size.Small" />
                                        </div>
                                    </div>
                                    <div class="saas-kpi-value">$@currentShift.ExpectedCash.ToString("N2")</div>
                                </div>
                                <div class="saas-kpi-subtext">
                                    +Ingresos: $@currentShift.TotalInflows.ToString("N2") | -Retiros: $@currentShift.TotalOutflows.ToString("N2")
                                </div>
                            </div>
                        </MudItem>
                    </MudGrid>

                    <!-- Quick actions -->
                    <div class="d-flex flex-wrap gap-2 mb-4 align-center">
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddCircleOutline"
                                   OnClick="@(() => OpenMovementDialog(CashMovementType.Inflow))" Size="Size.Small">
                            Ingreso Extraordinario
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Filled.RemoveCircleOutline"
                                   OnClick="@(() => OpenMovementDialog(CashMovementType.Outflow))" Size="Size.Small">
                            Retiro / Salida de Efectivo
                        </MudButton>
                        <MudSpacer />
                        <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Lock"
                                   OnClick="OpenCloseShiftDialog" Size="Size.Small">
                            Cerrar Turno y Arqueo
                        </MudButton>
                    </div>

                    <!-- Shift Movements Table -->
                    <div class="mud-paper pa-4">
                        <div class="mb-3">
                            <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">Movimientos del Turno Actual</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Registro de entradas y salidas de dinero extraordinarias en caja</MudText>
                        </div>

                        @if (currentShift.Movements == null || !currentShift.Movements.Any())
                        {
                            <div class="pa-4 text-center text-muted">
                                <MudText Typo="Typo.body2" Color="Color.Secondary">No se han registrado movimientos extraordinarios en este turno.</MudText>
                            </div>
                        }
                        else
                        {
                            <MudTable Items="@currentShift.Movements" Dense="true" Hover="true" Elevation="0">
                                <HeaderContent>
                                    <MudTh>Hora</MudTh>
                                    <MudTh>Tipo</MudTh>
                                    <MudTh>Motivo</MudTh>
                                    <MudTh>Registrado por</MudTh>
                                    <MudTh Style="text-align: right;">Monto</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd>@context.CreatedAtUtc.ToLocalTime().ToString("HH:mm")</MudTd>
                                    <MudTd>
                                        @if (context.Type == CashMovementType.Inflow)
                                        {
                                            <span class="saas-badge saas-badge-success">Ingreso</span>
                                        }
                                        else
                                        {
                                            <span class="saas-badge saas-badge-warning">Retiro / Egreso</span>
                                        }
                                    </MudTd>
                                    <MudTd>@context.Reason</MudTd>
                                    <MudTd>@context.CreatedByUserName</MudTd>
                                    <MudTd Style="@(context.Type == CashMovementType.Inflow ? "text-align: right; font-weight: 700; color: var(--saas-success-text);" : "text-align: right; font-weight: 700; color: var(--saas-error-text);")">
                                        @(context.Type == CashMovementType.Inflow ? "+" : "-")$@context.Amount.ToString("N2")
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        }
                    </div>
                }
            </MudTabPanel>

            <MudTabPanel Text="Historial de Cajas" Icon="@Icons.Material.Filled.History" OnClick="LoadHistory" Class="pa-4">
                @if (loadingHistory)
                {
                    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
                }
                else if (!shiftHistory.Any())
                {
                    <div class="pa-6 text-center text-muted">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">No hay registros de turnos de caja anteriores.</MudText>
                    </div>
                }
                else
                {
                    <MudTable Items="@shiftHistory" Dense="true" Hover="true" Elevation="0">
                        <HeaderContent>
                            <MudTh>Apertura</MudTh>
                            <MudTh>Cierre</MudTh>
                            <MudTh>Cajero</MudTh>
                            <MudTh Style="text-align: right;">Inicial</MudTh>
                            <MudTh Style="text-align: right;">Esperado</MudTh>
                            <MudTh Style="text-align: right;">Real Contado</MudTh>
                            <MudTh Style="text-align: right;">Diferencia</MudTh>
                            <MudTh>Estado</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.OpenedAtUtc.ToLocalTime().ToString("dd/MM/yy HH:mm")</MudTd>
                            <MudTd>@(context.ClosedAtUtc.HasValue ? context.ClosedAtUtc.Value.ToLocalTime().ToString("dd/MM/yy HH:mm") : "-")</MudTd>
                            <MudTd>@context.UserName</MudTd>
                            <MudTd Style="text-align: right;">$@context.InitialCash.ToString("N2")</MudTd>
                            <MudTd Style="text-align: right;">$@context.ExpectedCash.ToString("N2")</MudTd>
                            <MudTd Style="text-align: right; font-weight: 600;">$@context.ActualCash.ToString("N2")</MudTd>
                            <MudTd Style="text-align: right;">
                                <span style="font-weight: 700; color: @(context.Difference == 0 ? "var(--saas-success-text)" : (context.Difference > 0 ? "var(--saas-accent)" : "var(--saas-error-text)"));">
                                    @(context.Difference >= 0 ? "+" : "")$@context.Difference.ToString("N2")
                                </span>
                            </MudTd>
                            <MudTd>
                                @if (context.IsOpen)
                                {
                                    <span class="saas-badge saas-badge-success">Abierta</span>
                                }
                                else
                                {
                                    <span class="saas-badge saas-badge-neutral">Cerrada</span>
                                }
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudTabPanel>
        </MudTabs>
    }
</MudContainer>

<!-- Dialog: Add Cash Movement -->
<MudDialog @bind-Visible="movementDialogVisible" Options="dialogOptions">
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@(movementModel.Type == CashMovementType.Inflow ? Icons.Material.Filled.AddCircle : Icons.Material.Filled.RemoveCircle)"
                     Color="@(movementModel.Type == CashMovementType.Inflow ? Color.Success : Color.Warning)" Size="Size.Small" />
            <MudText Typo="Typo.subtitle1" Style="font-weight: 700;">
                @(movementModel.Type == CashMovementType.Inflow ? "Ingreso Extraordinario de Caja" : "Retiro / Salida de Efectivo")
            </MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudNumericField @bind-Value="movementModel.Amount" Label="Monto ($)" Variant="Variant.Outlined" Min="0.01m" Format="N2" Class="mb-3" />
        <MudTextField @bind-Value="movementModel.Reason" Label="Motivo o Detalle (Ej: Proveedor hielo, cambio)" Variant="Variant.Outlined" Required="true" Class="mb-3" />
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="@(() => movementDialogVisible = false)">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveMovementAsync" Disabled="savingMovement">
            @(savingMovement ? "Guardando..." : "Registrar Movimiento")
        </MudButton>
    </DialogActions>
</MudDialog>

<!-- Dialog: Close Shift & Arqueo -->
<MudDialog @bind-Visible="closeDialogVisible" Options="dialogOptions">
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Color="Color.Error" />
            <MudText Typo="Typo.subtitle1" Style="font-weight: 700;">Cierre de Turno y Arqueo</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        @if (currentShift != null)
        {
            <div class="pa-3 rounded mb-3" style="background-color: var(--saas-info-bg); border: 1px solid var(--saas-info-border); color: var(--saas-info-text); font-size: 0.875rem;">
                Efectivo teórico calculado según sistema: <b>$@currentShift.ExpectedCash.ToString("N2")</b>
            </div>

            <MudNumericField @bind-Value="closeModel.ActualCash" Label="Efectivo Real en Mano / Contado ($)" Variant="Variant.Outlined" Min="0m" Format="N2" Class="mb-3" />

            var diff = closeModel.ActualCash - currentShift.ExpectedCash;
            var diffBg = diff == 0 ? "var(--saas-success-bg)" : (diff > 0 ? "var(--saas-info-bg)" : "var(--saas-error-bg)");
            var diffBorder = diff == 0 ? "var(--saas-success-border)" : (diff > 0 ? "var(--saas-info-border)" : "var(--saas-error-border)");
            var diffColor = diff == 0 ? "var(--saas-success-text)" : (diff > 0 ? "var(--saas-info-text)" : "var(--saas-error-text)");
            <div class="pa-3 rounded mb-3" style="background-color: @diffBg; border: 1px solid @diffBorder; color: @diffColor; font-size: 0.875rem;">
                Diferencia de Arqueo: <b>@(diff >= 0 ? "+" : "")$@diff.ToString("N2")</b>
                @(diff == 0 ? " (Caja Exacta ✓)" : (diff > 0 ? " (Sobrante de caja)" : " (Faltante de caja)"))
            </div>

            <MudTextField @bind-Value="closeModel.Notes" Label="Observaciones del Cierre (Opcional)" Variant="Variant.Outlined" Lines="2" Class="mb-3" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="@(() => closeDialogVisible = false)">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="ConfirmCloseShiftAsync" Disabled="savingClose"
                   StartIcon="@Icons.Material.Filled.Lock">
            @(savingClose ? "Cerrando..." : "Confirmar Cierre de Caja")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private CurrentShiftResponse? currentShift;
    private List<CashShiftDto> shiftHistory = new();
    private bool loading = true;
    private bool loadingHistory = false;
    private bool saving = false;
    private bool savingMovement = false;
    private bool savingClose = false;

    private OpenShiftRequest openModel = new();
    private AddCashMovementRequest movementModel = new();
    private CloseShiftRequest closeModel = new();

    private bool movementDialogVisible = false;
    private bool closeDialogVisible = false;

    private DialogOptions dialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };

    protected override async Task OnInitializedAsync()
    {
        await LoadCurrentShift();
    }

    private async Task LoadCurrentShift()
    {
        loading = true;
        try
        {
            var res = await Http.GetFromJsonAsync<CurrentShiftResponse>("api/cash/current");
            currentShift = res;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al consultar caja: {ex.Message}", Severity.Error);
        }
        finally
        {
            loading = false;
        }
    }

    private async Task OpenShiftAsync()
    {
        if (openModel.InitialCash < 0)
        {
            Snackbar.Add("El fondo inicial no puede ser negativo.", Severity.Warning);
            return;
        }

        saving = true;
        try
        {
            var res = await Http.PostAsJsonAsync("api/cash/open", openModel);
            if (res.IsSuccessStatusCode)
            {
                Snackbar.Add("Caja abierta correctamente", Severity.Success);
                openModel = new();
                await LoadCurrentShift();
            }
            else
            {
                var err = await res.Content.ReadAsStringAsync();
                Snackbar.Add($"Error: {err}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            saving = false;
        }
    }

    private void OpenMovementDialog(CashMovementType type)
    {
        movementModel = new AddCashMovementRequest { Type = type, Amount = 0, Reason = string.Empty };
        movementDialogVisible = true;
    }

    private async Task SaveMovementAsync()
    {
        if (movementModel.Amount <= 0)
        {
            Snackbar.Add("El monto debe ser mayor a 0", Severity.Warning);
            return;
        }
        if (string.IsNullOrWhiteSpace(movementModel.Reason))
        {
            Snackbar.Add("El motivo es obligatorio", Severity.Warning);
            return;
        }

        savingMovement = true;
        try
        {
            var res = await Http.PostAsJsonAsync("api/cash/movement", movementModel);
            if (res.IsSuccessStatusCode)
            {
                Snackbar.Add("Movimiento registrado", Severity.Success);
                movementDialogVisible = false;
                await LoadCurrentShift();
            }
            else
            {
                var err = await res.Content.ReadAsStringAsync();
                Snackbar.Add($"Error: {err}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            savingMovement = false;
        }
    }

    private void OpenCloseShiftDialog()
    {
        if (currentShift != null)
        {
            closeModel = new CloseShiftRequest { ActualCash = currentShift.ExpectedCash, Notes = string.Empty };
            closeDialogVisible = true;
        }
    }

    private async Task ConfirmCloseShiftAsync()
    {
        savingClose = true;
        try
        {
            var res = await Http.PostAsJsonAsync("api/cash/close", closeModel);
            if (res.IsSuccessStatusCode)
            {
                Snackbar.Add("Caja cerrada exitosamente con arqueo.", Severity.Success);
                closeDialogVisible = false;
                await LoadCurrentShift();
            }
            else
            {
                var err = await res.Content.ReadAsStringAsync();
                Snackbar.Add($"Error al cerrar caja: {err}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            savingClose = false;
        }
    }

    private async Task LoadHistory()
    {
        loadingHistory = true;
        try
        {
            var history = await Http.GetFromJsonAsync<List<CashShiftDto>>("api/cash/history");
            shiftHistory = history ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar historial: {ex.Message}", Severity.Error);
        }
        finally
        {
            loadingHistory = false;
        }
    }
}
