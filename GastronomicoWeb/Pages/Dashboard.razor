@page "/dashboard"
@attribute [Authorize(Roles = "Owner,Admin")]
@using RotiseriaWeb.Models
@inject HttpClient Http

<PageTitle>Finanzas y Reportes - SaaS Gastronómico</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4 mb-8">
    <MudText Typo="Typo.h4" Class="mb-6" Color="Color.Primary">Resumen de Finanzas y Operación</MudText>

    @if (loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
    }
    else
    {
        <MudGrid>
            @* --- 1. FILA DE TARJETAS PRINCIPALES (4 métricas clave) --- *@
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Elevation="4" Class="pa-4 rounded-lg" Style="border-left: 6px solid #4caf50;">
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">VENTAS DE HOY</MudText>
                    <MudText Typo="Typo.h4"><b>$ @stats.SalesToday.ToString("N2")</b></MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudPaper Elevation="4" Class="pa-4 rounded-lg" Style="border-left: 6px solid #FF9800;">
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">CAJA DELIVERY</MudText>
                    <MudText Typo="Typo.h4"><b>$ @stats.DeliveryRevenue.ToString("N2")</b></MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@stats.DeliveryTrips viajes realizados</MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudPaper Elevation="4" Class="pa-4 rounded-lg" Style="border-left: 6px solid #f44336;">
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">DEUDA TOTAL (FIADOS)</MudText>
                    <MudText Typo="Typo.h4" Color="Color.Error"><b>$ @stats.TotalDebt.ToString("N2")</b></MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudPaper Elevation="4" Class="pa-4 rounded-lg" Style="border-left: 6px solid #2196f3;">
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">PEDIDOS DE HOY</MudText>
                    <MudText Typo="Typo.h4"><b>@stats.OrdersCount</b></MudText>
                </MudPaper>
            </MudItem>

            @* --- 2. ALERTA DE STOCK --- *@
            <MudItem xs="12" Class="mt-4">
                <MudCard Elevation="4">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">Productos con Bajo Stock</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        @if (stats.LowStock != null && stats.LowStock.Any())
                        {
                            <MudGrid>
                                @foreach (var item in stats.LowStock)
                                {
                                    <MudItem xs="12" sm="6" md="4">
                                        <div class="d-flex justify-space-between align-center pa-2"
                                             style="border: 1px solid rgba(255,255,255,0.1); border-radius: 6px;">
                                            <MudText>@item.Name</MudText>
                                            <MudChip T="string" Color="Color.Warning" Size="Size.Small">Quedan @item.Stock</MudChip>
                                        </div>
                                    </MudItem>
                                }
                            </MudGrid>
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Success">Stock de productos controlado adecuadamente.</MudAlert>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>

            @* --- 3. HISTORIAL MENSUAL (GRÁFICO Y TABLA) --- *@
            <MudItem xs="12" Class="mt-4">
                <MudCard Elevation="4">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">Ventas por Mes (Último Período)</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudGrid>
                            <MudItem xs="12" md="7">
                                @if (_series.Any())
                                {
                                    <MudChart ChartType="ChartType.Bar" ChartSeries="@_series" ChartLabels="@_labels"
                                              Width="100%" Height="300px" />
                                }
                                else
                                {
                                    <MudText Class="pa-4">Sin datos suficientes para graficar.</MudText>
                                }
                            </MudItem>
                            <MudItem xs="12" md="5">
                                <MudTable Items="@monthlyData" Dense="true" Hover="true" Height="300px" FixedHeader="true">
                                    <HeaderContent>
                                        <MudTh>Mes</MudTh>
                                        <MudTh>Total Mensual</MudTh>
                                        <MudTh>Pedidos</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd>@context.Label</MudTd>
                                        <MudTd><b>$ @context.Total.ToString("N2")</b></MudTd>
                                        <MudTd>@context.OrderCount</MudTd>
                                    </RowTemplate>
                                </MudTable>
                            </MudItem>
                        </MudGrid>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    }
</MudContainer>

@code {
    private DashboardDTO stats = new();
    private List<MonthlyReportDTO> monthlyData = new();
    private List<ChartSeries<double>> _series = new();
    private string[] _labels = { };
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result = await Http.GetFromJsonAsync<DashboardDTO>("api/Reports/dashboard");
            if (result != null) stats = result;

            var history = await Http.GetFromJsonAsync<List<MonthlyReportDTO>>("api/Reports/monthly-history");
            if (history != null && history.Any())
            {
                monthlyData = history;
                _labels = history.Select(x => x.Label).ToArray();
                _series = new List<ChartSeries<double>>()
                {
                    new ChartSeries<double>() { Name = "Ventas Mensuales", Data = history.Select(x => (double)x.Total).ToArray() }
                };
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error cargando estadísticas: " + ex.Message);
        }
        finally
        {
            loading = false;
        }
    }

    public class MonthlyReportDTO
    {
        public string Label { get; set; } = "";
        public decimal Total { get; set; }
        public int OrderCount { get; set; }
    }
}