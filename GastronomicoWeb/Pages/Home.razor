@page "/"
@using RotiseriaWeb.Models
@using RotiseriaWeb.Services
@using MudBlazor
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject SaaSStateService SaaSState

<PageTitle>Punto de Venta (POS) - @(SaaSState.CurrentBusiness?.TradeName ?? "SaaS Gastronómico")</PageTitle>

<style>
    @@media print {
        body * {
            visibility: hidden !important;
        }
        #thermal-receipt-container, #thermal-receipt-container * {
            visibility: visible !important;
        }
        #thermal-receipt-container {
            position: absolute !important;
            left: 0 !important;
            top: 0 !important;
            width: 78mm !important;
            margin: 0 !important;
            padding: 4mm !important;
            font-family: 'Courier New', Courier, monospace !important;
            font-size: 12px !important;
            color: black !important;
            background: white !important;
        }
    }
</style>

<MudContainer MaxWidth="MaxWidth.False" Class="py-2">
    <MudGrid Spacing="3">
        @* COLUMNA IZQUIERDA: PRODUCTOS *@
        <MudItem xs="12" md="8">
            <div class="d-flex flex-wrap justify-space-between align-center mb-4 gap-2">
                <div>
                    <MudText Typo="Typo.h4" Style="font-weight: 700; letter-spacing: -0.02em;">Menú & Catálogo</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Explorá productos, filtrá por categorías y armá la comanda en segundos.</MudText>
                </div>
                @if (_lastCreatedOrder != null)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Receipt"
                               OnClick="@(() => _showReceiptModal = true)" Size="Size.Small">
                        Último Ticket (#@_lastCreatedOrder.Id)
                    </MudButton>
                }
            </div>

            @* BUSCADOR Y CATEGORÍAS *@
            <div class="mud-paper pa-4 mb-4">
                <MudTextField @bind-Value="searchString" Placeholder="Buscar por nombre de producto o categoría..."
                              Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                              Margin="Margin.Dense" Immediate="true" Clearable="true" Class="mb-3" />

                <div class="d-flex flex-wrap gap-1 align-center">
                    <button type="button" class="saas-cat-pill @(_selectedCategoryId == null ? "active" : "")"
                            @onclick="@(() => _selectedCategoryId = null)">
                        Todos los platos
                    </button>
                    @foreach (var cat in categories)
                    {
                        <button type="button" class="saas-cat-pill @(_selectedCategoryId == cat.Id ? "active" : "")"
                                @onclick="@(() => _selectedCategoryId = cat.Id)">
                            @cat.Name
                        </button>
                    }
                </div>
            </div>

            <MudGrid Spacing="3">
                @if (products == null)
                {
                    <MudItem xs="12" Class="text-center py-8">
                        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">Cargando catálogo...</MudText>
                    </MudItem>
                }
                else if (!FilteredProducts.Any())
                {
                    <MudItem xs="12">
                        <div class="mud-paper pa-8 text-center">
                            <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Color="Color.Secondary" Class="mb-2" />
                            <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">No se encontraron productos</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Probá ajustando el término de búsqueda o seleccioná otra categoría.</MudText>
                        </div>
                    </MudItem>
                }
                else
                {
                    @foreach (var prod in FilteredProducts)
                    {
                        <MudItem @key="prod.Id" xs="12" sm="6" lg="4">
                            <div class="saas-product-card pa-4 h-100 d-flex flex-column justify-space-between">
                                <div>
                                    <div class="d-flex justify-space-between align-start mb-2 gap-1">
                                        <MudText Typo="Typo.subtitle1" Style="font-weight: 600; line-height: 1.2;">@prod.Name</MudText>
                                        <span class="saas-badge saas-badge-neutral" style="font-size: 0.7rem; white-space: nowrap;">
                                            @(prod.Category?.Name ?? "General")
                                        </span>
                                    </div>
                                    <div class="d-flex align-baseline gap-2 mb-2">
                                        <MudText Typo="Typo.h5" Style="font-weight: 700; color: var(--saas-text-primary);">
                                            $@prod.Price.ToString("N2")
                                        </MudText>
                                        @if (prod.Stock > 0)
                                        {
                                            <span class="saas-badge @(prod.Stock <= 5 ? "saas-badge-warning" : "saas-badge-neutral")" style="font-size: 0.65rem;">
                                                Stock: @prod.Stock
                                            </span>
                                        }
                                    </div>
                                </div>
                                <div class="mt-2">
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.AddShoppingCart"
                                               OnClick="@(() => AddToCart(prod))">
                                        Agregar al Pedido
                                    </MudButton>
                                </div>
                            </div>
                        </MudItem>
                    }
                }
            </MudGrid>
        </MudItem>

        @* COLUMNA DERECHA: CARRITO *@
        <MudItem xs="12" md="4">
            <div class="mud-paper pa-5" style="position: sticky; top: 76px;">
                <div class="d-flex justify-space-between align-center mb-4 pb-2" style="border-bottom: 1px solid var(--saas-border-subtle);">
                    <div>
                        <MudText Typo="Typo.h6" Style="font-weight: 700;">Comanda Actual</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Detalle de ítems a facturar</MudText>
                    </div>
                    @if (cart.Any())
                    {
                        <span class="saas-badge saas-badge-info">@cart.Sum(x => x.Quantity) ítems</span>
                    }
                </div>

                @if (cart.Any())
                {
                    <div class="mb-4 d-flex flex-column gap-2" style="max-height: 250px; overflow-y: auto; padding-right: 4px;">
                        @foreach (var item in cart)
                        {
                            <div @key="item.ProductId" class="d-flex align-center justify-space-between pa-2 rounded"
                                 style="border: 1px solid var(--saas-border-subtle); background-color: var(--saas-surface);">
                                <div style="flex-grow: 1; min-width: 0;" class="pr-2">
                                    <MudText Typo="Typo.body2" Style="font-weight: 600; text-overflow: ellipsis; overflow: hidden; white-space: nowrap;">
                                        @item.ProductName
                                    </MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">$@item.UnitPrice.ToString("N2") c/u</MudText>
                                </div>
                                <div class="d-flex align-center gap-1">
                                    <MudIconButton Icon="@Icons.Material.Filled.Remove" Size="Size.Small"
                                                   Color="Color.Default" OnClick="@(() => RestarCantidad(item))"
                                                   Style="width: 26px; height: 26px; padding: 0; border: 1px solid var(--saas-border);" />
                                    <span style="min-width: 24px; text-align: center; font-weight: 600; font-size: 0.875rem;">@item.Quantity</span>
                                    <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" Color="Color.Default"
                                                   OnClick="@(() => AddToCartFromList(item))"
                                                   Style="width: 26px; height: 26px; padding: 0; border: 1px solid var(--saas-border);" />
                                    <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Small"
                                                   Color="Color.Error" OnClick="@(() => RemoveFromCart(item))"
                                                   Class="ml-1" Style="width: 26px; height: 26px; padding: 0;" />
                                </div>
                            </div>
                        }
                    </div>

                    <div class="mb-3 pa-3 rounded" style="background-color: var(--saas-surface-subtle); border: 1px solid var(--saas-border-subtle);">
                        <div class="d-flex justify-space-between mb-1">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Subtotal de platos</MudText>
                            <MudText Typo="Typo.body2" Style="font-weight: 600;">$ @SubtotalCart.ToString("N2")</MudText>
                        </div>

                        @if (orderType == "Delivery")
                        {
                            <div class="d-flex justify-space-between mb-1">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Costo de Envío</MudText>
                                <MudText Typo="Typo.body2" Style="font-weight: 600;">$ @deliveryCost.ToString("N2")</MudText>
                            </div>
                        }

                        <MudDivider Class="my-2" />

                        <div class="d-flex justify-space-between align-center">
                            <MudText Typo="Typo.subtitle1" Style="font-weight: 700;">Total a Cobrar</MudText>
                            <MudText Typo="Typo.h5" Style="font-weight: 800; color: var(--saas-text-primary);">$ @TotalCart.ToString("N2")</MudText>
                        </div>
                    </div>
                }
                else
                {
                    <div class="pa-6 text-center my-3 rounded" style="border: 1px dashed var(--saas-border); background-color: var(--saas-surface-subtle);">
                        <MudIcon Icon="@Icons.Material.Filled.ShoppingBag" Size="Size.Medium" Color="Color.Secondary" Class="mb-2" />
                        <MudText Typo="Typo.subtitle2" Style="font-weight: 600;">Comanda Vacía</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Seleccioná platos del catálogo para agregarlos.</MudText>
                    </div>
                }

                <div class="d-flex flex-column gap-2 mt-3">
                    <MudSelect T="string" @bind-Value="orderType" Label="Modalidad de Pedido" Variant="Variant.Outlined"
                               Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter">
                        <MudSelectItem T="string" Value="@("Local")">Mostrador (Para llevar)</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Delivery")">Envío a Domicilio</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Salon")">Comer en Salón (Mesa)</MudSelectItem>
                    </MudSelect>

                    @if (orderType == "Salon")
                    {
                        <MudSelect T="int?" @bind-Value="selectedTableId" Label="Seleccionar Mesa" Variant="Variant.Outlined"
                                   Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter">
                            @foreach (var t in tables)
                            {
                                <MudSelectItem @key="t.Id" T="int?" Value="@t.Id">
                                    Mesa @t.Number @(t.Status == "Ocupada" ? "🔴 (Ocupada - Adicionar)" : "🟢 (Libre)")
                                </MudSelectItem>
                            }
                        </MudSelect>
                    }
                    else if (orderType == "Delivery")
                    {
                        <MudTextField @bind-Value="deliveryAddress" Label="Dirección de Entrega" Variant="Variant.Outlined"
                                      Margin="Margin.Dense" />

                        <MudNumericField T="decimal" @bind-Value="deliveryCost" Label="Costo del Envío ($)"
                                         Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Format="N2" />
                    }

                    @if (orderType != "Salon")
                    {
                        <MudSelect T="int?" @bind-Value="selectedCustomerId" Label="Cliente Registrado (Opcional)"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" AnchorOrigin="Origin.BottomCenter">
                            @foreach (var c in customers)
                            {
                                <MudSelectItem @key="c.Id" T="int?" Value="@c.Id">@c.Name (@c.Phone)</MudSelectItem>
                            }
                        </MudSelect>

                        @if (!selectedCustomerId.HasValue)
                        {
                            <MudTextField @bind-Value="customerName" Label="Nombre de Cliente Ocasional"
                                          Variant="Variant.Outlined" Margin="Margin.Dense" />
                        }
                    }

                    <MudSelect T="string" @bind-Value="selectedPayment" Label="Medio de Pago" Variant="Variant.Outlined"
                               Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter">
                        <MudSelectItem T="string" Value="@("Efectivo")">Efectivo</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Transferencia")">Transferencia / QR</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Tarjeta")">Tarjeta Débito/Crédito</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Cuenta Corriente")">Cuenta Corriente (Fiado)</MudSelectItem>
                    </MudSelect>

                    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large"
                               Class="mt-2"
                               Disabled="@(isProcessing || !cart.Any() || (orderType != "Salon" && !selectedCustomerId.HasValue && string.IsNullOrWhiteSpace(customerName)))"
                               OnClick="ConfirmarPedido" StartIcon="@Icons.Material.Filled.CheckCircle">
                        @(isProcessing ? "Procesando comanda..." : "Confirmar Pedido")
                    </MudButton>
                </div>
            </div>
        </MudItem>
    </MudGrid>
</MudContainer>

@* MODAL DE TICKET TÉRMICO *@
<MudDialog @bind-Visible="_showReceiptModal" Options="_receiptDialogOptions">
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.Receipt" Size="Size.Small" />
            <MudText Typo="Typo.subtitle1" Style="font-weight: 700;">Ticket de Venta</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        @if (_lastCreatedOrder != null)
        {
            <div id="thermal-receipt-container" class="pa-4 thermal-receipt-preview" style="font-family: monospace; border-radius: 8px;">
                <div style="text-align: center; margin-bottom: 8px;">
                    <div style="font-size: 15px; font-weight: bold; letter-spacing: -0.01em;">@(SaaSState.CurrentBusiness?.TradeName ?? "SAAS GASTRONOMICO")</div>
                    @if (!string.IsNullOrWhiteSpace(SaaSState.CurrentBusiness?.TaxId))
                    {
                        <div style="font-size: 11px;">CUIT: @SaaSState.CurrentBusiness.TaxId</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(SaaSState.CurrentBusiness?.Address))
                    {
                        <div style="font-size: 11px;">@SaaSState.CurrentBusiness.Address</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(SaaSState.CurrentBusiness?.Phone))
                    {
                        <div style="font-size: 11px;">Tel: @SaaSState.CurrentBusiness.Phone</div>
                    }
                    <div class="thermal-receipt-divider" style="margin: 8px 0;"></div>
                    <div style="font-size: 13px; font-weight: bold;">PEDIDO #@_lastCreatedOrder.Id</div>
                    <div style="font-size: 11px;">Fecha: @_lastCreatedOrder.Date.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                    <div style="font-size: 11px;">Tipo: @_lastCreatedOrder.OrderType</div>
                    @if (!string.IsNullOrWhiteSpace(_lastCreatedOrder.ClientName))
                    {
                        <div style="font-size: 11px;">Cliente: @_lastCreatedOrder.ClientName</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_lastCreatedOrder.DeliveryAddress))
                    {
                        <div style="font-size: 11px;">Dirección: @_lastCreatedOrder.DeliveryAddress</div>
                    }
                </div>

                <div class="thermal-receipt-divider" style="margin: 8px 0;"></div>
                <table style="width: 100%; font-size: 12px; border-collapse: collapse;">
                    <thead>
                        <tr style="text-align: left; border-bottom: 1px solid var(--saas-border-subtle);">
                            <th>Cant</th>
                            <th>Prod</th>
                            <th style="text-align: right;">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var it in _lastCreatedOrder.Items)
                        {
                            <tr>
                                <td style="vertical-align: top;">@it.Quantity</td>
                                <td style="vertical-align: top;">@it.ProductName</td>
                                <td style="text-align: right; vertical-align: top;">$@((it.Quantity * it.UnitPrice).ToString("N2"))</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div style="border-bottom: 1px dashed black; margin: 8px 0;"></div>

                <div style="display: flex; justify-content: space-between; font-size: 12px; margin-bottom: 2px;">
                    <span>Medio de Pago:</span>
                    <span style="font-weight: bold;">@_lastCreatedOrder.PaymentMethod</span>
                </div>
                @if (_lastCreatedOrder.DeliveryCost > 0)
                {
                    <div style="display: flex; justify-content: space-between; font-size: 12px; margin-bottom: 2px;">
                        <span>Costo de Envío:</span>
                        <span>$@_lastCreatedOrder.DeliveryCost.ToString("N2")</span>
                    </div>
                }
                <div style="display: flex; justify-content: space-between; font-size: 14px; font-weight: bold; margin-top: 6px; padding-top: 4px; border-top: 1px solid #ddd;">
                    <span>TOTAL:</span>
                    <span>$@_lastCreatedOrder.Total.ToString("N2")</span>
                </div>

                <div style="text-align: center; margin-top: 12px; font-size: 11px; color: #555;">
                    ¡Muchas gracias por su compra!
                </div>
            </div>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="@(() => _showReceiptModal = false)">Cerrar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Print" OnClick="PrintReceipt">
            Imprimir Ticket
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<Product>? products;
    private List<Category> categories = new();
    private List<CartItem> cart = new();
    private List<RotiseriaWeb.Models.Customer> customers = new();
    private List<Table> tables = new();

    private string searchString = "";
    private int? _selectedCategoryId;
    private int? selectedCustomerId;
    private int? selectedTableId;
    private decimal deliveryCost = 1500;

    private bool isProcessing = false;
    private string selectedPayment = "Efectivo";
    private string orderType = "Local";
    private string deliveryAddress = "";
    private string customerName = "";

    private Order? _lastCreatedOrder;
    private bool _showReceiptModal = false;
    private DialogOptions _receiptDialogOptions = new() { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, CloseButton = true };

    private IEnumerable<Product> FilteredProducts
    {
        get
        {
            var list = products ?? new List<Product>();
            if (_selectedCategoryId.HasValue)
            {
                list = list.Where(p => p.CategoryId == _selectedCategoryId.Value).ToList();
            }

            if (string.IsNullOrWhiteSpace(searchString))
                return list;

            return list.Where(p =>
                p.Name.Contains(searchString, StringComparison.OrdinalIgnoreCase) ||
                (p.Category?.Name ?? "").Contains(searchString, StringComparison.OrdinalIgnoreCase));
        }
    }

    private decimal SubtotalCart => cart.Sum(x => x.Quantity * x.UnitPrice);
    private decimal TotalCart => SubtotalCart + (orderType == "Delivery" ? deliveryCost : 0);

    protected override async Task OnInitializedAsync()
    {
        await CargarDatosAsync();
    }

    private async Task CargarDatosAsync()
    {
        try
        {
            var pTask = Http.GetFromJsonAsync<List<Product>>("api/Producto/activos");
            var cTask = Http.GetFromJsonAsync<List<Category>>("api/Categories");
            var custTask = Http.GetFromJsonAsync<List<RotiseriaWeb.Models.Customer>>("api/Customer");
            var tTask = Http.GetFromJsonAsync<List<Table>>($"api/Tables?t={DateTime.Now.Ticks}");

            await Task.WhenAll(pTask, cTask, custTask, tTask);

            products = await pTask ?? new();
            categories = await cTask ?? new();
            customers = await custTask ?? new();
            tables = await tTask ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al conectar con el servidor: {ex.Message}", Severity.Error);
        }
    }

    private void AddToCart(Product prod)
    {
        var item = cart.FirstOrDefault(x => x.ProductId == prod.Id);
        if (item == null)
        {
            cart.Add(new CartItem { ProductId = prod.Id, ProductName = prod.Name, UnitPrice = prod.Price, Quantity = 1 });
        }
        else
        {
            item.Quantity++;
        }
        Snackbar.Add($"{prod.Name} agregado", Severity.Success);
    }

    private void AddToCartFromList(CartItem item) => item.Quantity++;

    private void RestarCantidad(CartItem item)
    {
        if (item.Quantity > 1) item.Quantity--;
        else cart.Remove(item);
    }

    private void RemoveFromCart(CartItem item)
    {
        cart.Remove(item);
        Snackbar.Add("Producto quitado", Severity.Info);
    }

    private async Task ConfirmarPedido()
    {
        if (orderType == "Salon" && !selectedTableId.HasValue)
        {
            Snackbar.Add("Para Salón, debes seleccionar un número de Mesa.", Severity.Warning);
            return;
        }

        if (selectedPayment == "Cuenta Corriente" && !selectedCustomerId.HasValue && orderType != "Salon")
        {
            Snackbar.Add("Para vender por Cuenta Corriente, debes seleccionar un cliente registrado.", Severity.Warning);
            return;
        }

        if (orderType == "Salon" && selectedTableId.HasValue)
        {
            var mesaSeleccionada = tables.FirstOrDefault(t => t.Id == selectedTableId.Value);
            if (mesaSeleccionada != null && mesaSeleccionada.Status == "Ocupada")
            {
                bool confirmado = await JS.InvokeAsync<bool>("confirm", $"¡ATENCIÓN!\nLa Mesa {mesaSeleccionada.Number} ya está OCUPADA.\n\n¿Estás seguro de que querés AGREGAR estos productos a esa misma cuenta?");
                if (!confirmado) return;
            }
        }

        isProcessing = true;
        try
        {
            string finalCustomerName = customerName;
            if (selectedCustomerId.HasValue)
            {
                var cliente = customers.FirstOrDefault(c => c.Id == selectedCustomerId.Value);
                if (cliente != null) finalCustomerName = cliente.Name;
            }

            var nuevoPedido = new CreateOrderRequest
            {
                CustomerId = selectedCustomerId,
                ClientName = orderType == "Salon" ? "" : finalCustomerName,
                TableId = orderType == "Salon" ? selectedTableId : null,
                Items = cart.Select(x => new CreateOrderItemRequest
                {
                    ProductId = x.ProductId,
                    Quantity = x.Quantity
                }).ToList(),
                DeliveryCost = orderType == "Delivery" ? deliveryCost : 0,
                PaymentMethod = selectedPayment,
                DeliveryAddress = orderType == "Delivery" ? deliveryAddress : "",
                OrderType = orderType
            };

            var response = await Http.PostAsJsonAsync("api/Orders", nuevoPedido);
            if (response.IsSuccessStatusCode)
            {
                _lastCreatedOrder = await response.Content.ReadFromJsonAsync<Order>();
                Snackbar.Add("¡Pedido registrado exitosamente!", Severity.Success);

                cart.Clear();
                customerName = "";
                selectedCustomerId = null;
                selectedTableId = null;
                deliveryAddress = "";
                searchString = "";

                _showReceiptModal = true;
                await CargarDatosAsync();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Error: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task PrintReceipt()
    {
        await JS.InvokeVoidAsync("window.print");
    }
}