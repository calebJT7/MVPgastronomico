@page "/salon"
@using RotiseriaWeb.Models
@using RotiseriaWeb.Services
@using Microsoft.AspNetCore.SignalR.Client
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject ILocalStorageService LocalStorage
@inject SaaSStateService SaaSState
@implements IAsyncDisposable

<PageTitle>Salón y Mesas - SaaS Gastronómico</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-2 mb-8">
    <div class="d-flex flex-wrap justify-space-between align-center mb-6 gap-2">
        <div>
            <div class="d-flex align-center gap-2">
                <MudText Typo="Typo.h4" Style="font-weight: 700; letter-spacing: -0.02em;">Mapa de Salón y Mesas</MudText>
                @if (IsConnected)
                {
                    <span class="saas-badge saas-badge-success" style="font-size: 0.7rem;">● En Vivo (SignalR)</span>
                }
                else
                {
                    <span class="saas-badge saas-badge-warning" style="font-size: 0.7rem;">○ Conectando...</span>
                }
            </div>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Gestión en tiempo real de mesas ocupadas, comandas en curso y cobro de cuentas.</MudText>
        </div>
        <div class="d-flex gap-2">
            <AuthorizeView Roles="Owner,Admin,Manager,Tester">
                <Authorized>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                               OnClick="CrearNuevaMesaAsync" Size="Size.Small">
                        Nueva Mesa
                    </MudButton>
                </Authorized>
            </AuthorizeView>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="CargarMesas" Size="Size.Small">
                Actualizar
            </MudButton>
        </div>
    </div>

    @if (mesas == null)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
    }
    else if (!mesas.Any())
    {
        <div class="mud-paper pa-8 text-center my-6">
            <MudIcon Icon="@Icons.Material.Filled.TableRestaurant" Size="Size.Large" Color="Color.Secondary" Class="mb-3" />
            <MudText Typo="Typo.h6" Style="font-weight: 600;">No hay mesas configuradas</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">Agregá las mesas de tu salón para comenzar a tomar pedidos y comandas presenciales.</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CrearNuevaMesaAsync">
                Crear Mesa 1
            </MudButton>
        </div>
    }
    else
    {
        <!-- Resumen de estado de mesas -->
        <div class="d-flex flex-wrap gap-3 mb-4">
            <div class="d-flex align-center gap-2 pa-2 px-3 rounded" style="background-color: var(--saas-surface); border: 1px solid var(--saas-border);">
                <span style="width: 10px; height: 10px; border-radius: 50%; background-color: #10b981;"></span>
                <span style="font-size: 0.8125rem; font-weight: 600;">@mesas.Count(m => m.Status != "Ocupada") Libres</span>
            </div>
            <div class="d-flex align-center gap-2 pa-2 px-3 rounded" style="background-color: var(--saas-surface); border: 1px solid var(--saas-border);">
                <span style="width: 10px; height: 10px; border-radius: 50%; background-color: #ef4444;"></span>
                <span style="font-size: 0.8125rem; font-weight: 600;">@mesas.Count(m => m.Status == "Ocupada") Ocupadas</span>
            </div>
            <div class="d-flex align-center gap-2 pa-2 px-3 rounded" style="background-color: var(--saas-surface); border: 1px solid var(--saas-border);">
                <span style="font-size: 0.8125rem; color: var(--saas-text-secondary);">Total: @mesas.Count mesas</span>
            </div>
        </div>

        <MudGrid Spacing="3">
            @foreach (var mesa in mesas)
            {
                bool isOcupada = mesa.Status == "Ocupada";

                <MudItem xs="12" sm="6" md="4" lg="3">
                    <div class="saas-mesa-card @(isOcupada ? "ocupada" : "libre") d-flex flex-column justify-space-between h-100">
                        <div>
                            <div class="d-flex justify-space-between align-center mb-1">
                                <span style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--saas-text-secondary);">
                                    MESA
                                </span>
                                <div class="d-flex align-center gap-1">
                                    @if (isOcupada)
                                    {
                                        <span class="saas-badge saas-badge-error">Ocupada</span>
                                    }
                                    else
                                    {
                                        <span class="saas-badge saas-badge-success">Libre</span>
                                        <AuthorizeView Roles="Owner,Admin,Tester">
                                            <Authorized>
                                                <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Small"
                                                               Color="Color.Default"
                                                               OnClick="@(() => EliminarMesa(mesa.Id))"
                                                               Style="padding: 2px; width: 22px; height: 22px;" />
                                            </Authorized>
                                        </AuthorizeView>
                                    }
                                </div>
                            </div>

                            <div class="text-center my-3">
                                <MudText Typo="Typo.h2" Style="font-weight: 800; color: var(--saas-text-primary); line-height: 1;">
                                    @mesa.Number
                                </MudText>
                            </div>
                        </div>

                        <div class="mt-3 pt-3 d-flex flex-column gap-2" style="border-top: 1px solid var(--saas-border-subtle);">
                            @if (isOcupada)
                            {
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" FullWidth="true"
                                           StartIcon="@Icons.Material.Filled.Receipt"
                                           OnClick="@(() => VerCuenta(mesa.Id))">
                                    Ver / Cobrar Cuenta
                                </MudButton>
                                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" FullWidth="true"
                                           StartIcon="@Icons.Material.Filled.Add"
                                           OnClick="IrACaja">
                                    Adicionar Pedido
                                </MudButton>
                            }
                            else
                            {
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" FullWidth="true"
                                           StartIcon="@Icons.Material.Filled.AddShoppingCart"
                                           OnClick="IrACaja">
                                    Abrir Mesa
                                </MudButton>
                            }
                        </div>
                    </div>
                </MudItem>
            }
        </MudGrid>
    }
</MudContainer>

@* MODAL PARA VER CUENTA Y COBRAR *@
<MudDialog @bind-Visible="dialogVisible" Options="dialogOptions">
    <TitleContent>
        <div class="d-flex align-center justify-space-between w-100 pr-4">
            <div class="d-flex align-center gap-2">
                <div style="width: 28px; height: 28px; border-radius: 6px; background-color: var(--saas-primary); color: var(--saas-primary-text); display: flex; align-items: center; justify-content: center;">
                    <MudIcon Icon="@Icons.Material.Filled.TableRestaurant" Size="Size.Small" />
                </div>
                <MudText Typo="Typo.subtitle1" Style="font-weight: 700;">Cuenta Mesa @mesaSeleccionada?.Number</MudText>
            </div>
            <span class="saas-badge saas-badge-error">En Atención</span>
        </div>
    </TitleContent>
    <DialogContent>
        @if (cuentaActual != null)
        {
            <div class="mb-3" style="max-height: 220px; overflow-y: auto;">
                <MudList T="string" Dense="true">
                    @foreach (var item in cuentaActual.Items)
                    {
                        <MudListItem T="string" Class="px-0 py-1">
                            <div class="d-flex justify-space-between align-center">
                                <div>
                                    <span style="font-weight: 600;">@item.Quantity x</span>
                                    <span class="ml-1">@item.ProductName</span>
                                </div>
                                <span style="font-weight: 600;">$@((item.UnitPrice * item.Quantity).ToString("N2"))</span>
                            </div>
                        </MudListItem>
                    }
                </MudList>
            </div>

            <div class="pa-3 rounded mb-3" style="background-color: var(--saas-surface-subtle); border: 1px solid var(--saas-border-subtle);">
                <div class="d-flex justify-space-between align-center">
                    <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">Subtotal de la Mesa:</MudText>
                    <MudText Typo="Typo.h6" Style="font-weight: 700; color: var(--saas-text-primary);">$ @cuentaActual.Total.ToString("N2")</MudText>
                </div>
            </div>

            <div class="d-flex gap-2 mb-2">
                <MudSelect T="string" @bind-Value="medioPago" Label="Forma de Pago" Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem Value="@("Efectivo")">Efectivo</MudSelectItem>
                    <MudSelectItem Value="@("Tarjeta Débito/Crédito")">Tarjeta Débito/Crédito</MudSelectItem>
                    <MudSelectItem Value="@("Transferencia / MP")">Transferencia / QR</MudSelectItem>
                </MudSelect>
                <MudNumericField @bind-Value="propinaMonto" Label="Propina Voluntaria ($)" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0m" Format="N2" />
            </div>

            @if (propinaMonto > 0)
            {
                <div class="d-flex justify-space-between align-center pa-2 px-3 rounded mb-3" style="background-color: var(--saas-success-bg); border: 1px solid var(--saas-success-border);">
                    <span style="font-weight: 600; color: var(--saas-success-text);">Total Final con Propina:</span>
                    <span style="font-weight: 800; font-size: 1.15rem; color: var(--saas-success-text);">$ @((cuentaActual.Total + propinaMonto).ToString("N2"))</span>
                </div>
            }

            <MudDivider Class="my-3" />

            <!-- Dividir Cuenta -->
            <div class="d-flex justify-space-between align-center mb-2">
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.CallSplit" OnClick="ToggleSplitBill">
                    @(showSplitBill ? "Ocultar Calculadora de División" : "Dividir Cuenta por Persona")
                </MudButton>
            </div>

            @if (showSplitBill)
            {
                <div class="pa-3 rounded mb-2" style="background: var(--saas-surface-subtle); border: 1px solid var(--saas-border);">
                    @if (!SaaSState.HasFeature(FeatureCodes.SplitBills))
                    {
                        <div class="text-center py-2">
                            <span class="saas-badge saas-badge-warning mb-1">PLAN PREMIUM</span>
                            <MudText Typo="Typo.body2" Class="my-1">La división de cuentas y propinas por persona está disponible en el Plan Premium.</MudText>
                            <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="@(() => Nav.NavigateTo("/subscription"))">Mejorar Plan</MudButton>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex gap-2 align-center">
                            <MudNumericField @bind-Value="splitParts" Label="Personas" Min="2" Max="50" Margin="Margin.Dense" Variant="Variant.Outlined" />
                            <MudNumericField @bind-Value="splitTipPercent" Label="% Propina" Min="0m" Max="50m" Margin="Margin.Dense" Variant="Variant.Outlined" />
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="CalcularSplitBill">Calcular</MudButton>
                        </div>
                        @if (splitResult != null)
                        {
                            <div class="pa-2 mt-2 rounded" style="background-color: var(--saas-info-bg); border: 1px solid var(--saas-info-border); color: var(--saas-info-text); font-size: 0.8125rem;">
                                <b>@splitResult.Parts comensales</b> pagan: <b>$@splitResult.PerPerson.ToString("N2") cada uno</b>
                                <br/><small>(Total final c/propina: $@splitResult.TotalWithTip.ToString("N2"))</small>
                            </div>
                        }
                    }
                </div>
            }
        }
        else
        {
            <div class="text-center py-6">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">Cargando comanda de la mesa...</MudText>
            </div>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="CerrarDialogo">Volver</MudButton>
        <MudButton Color="Color.Success" Variant="Variant.Filled" OnClick="CobrarMesa" Size="Size.Medium" Disabled="_cobrando"
                   StartIcon="@Icons.Material.Filled.CheckCircle">
            @(_cobrando ? "Procesando cobro..." : "Cobrar y Liberar Mesa")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<Table>? mesas;
    private bool dialogVisible;
    private bool _cobrando = false;
    private Table? mesaSeleccionada;
    private Order? cuentaActual;
    private string medioPago = "Efectivo";
    private decimal propinaMonto = 0m;
    private bool showSplitBill = false;
    private int splitParts = 2;
    private decimal splitTipPercent = 10m;
    private SplitBillResultDto? splitResult;
    private DialogOptions dialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
    private HubConnection? _hubConnection;

    public bool IsConnected => _hubConnection?.State == HubConnectionState.Connected;

    protected override async Task OnInitializedAsync()
    {
        await CargarMesas();
        await SetupSignalRAsync();
    }

    private async Task SetupSignalRAsync()
    {
        try
        {
            var hubUri = new Uri(Http.BaseAddress ?? new Uri(Nav.BaseUri), "hubs/orders");
            _hubConnection = new HubConnectionBuilder()
                .WithUrl(hubUri, options =>
                {
                    options.AccessTokenProvider = async () =>
                    {
                        return await LocalStorage.GetItemAsync(JwtAuthenticationStateProvider.TokenKey);
                    };
                })
                .WithAutomaticReconnect()
                .Build();

            _hubConnection.On<object>("TableUpdated", async (payload) =>
            {
                await CargarMesas();
                await InvokeAsync(StateHasChanged);
            });

            _hubConnection.On<object>("OrderUpdated", async (payload) =>
            {
                await CargarMesas();
                await InvokeAsync(StateHasChanged);
            });

            await _hubConnection.StartAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"SignalR Salon error: {ex.Message}");
        }
    }

    private async Task CargarMesas()
    {
        try
        {
            mesas = await Http.GetFromJsonAsync<List<Table>>($"api/Tables?t={DateTime.UtcNow.Ticks}");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar mesas: {ex.Message}", Severity.Error);
        }
    }

    private void IrACaja()
    {
        Nav.NavigateTo("/");
    }

    private async Task CrearNuevaMesaAsync()
    {
        int nextNumber = (mesas?.Any() == true) ? mesas.Max(m => m.Number) + 1 : 1;
        var newTable = new Table { Number = nextNumber, Status = "Libre" };
        var res = await Http.PostAsJsonAsync("api/Tables", newTable);
        if (res.IsSuccessStatusCode)
        {
            Snackbar.Add($"Mesa {nextNumber} creada con éxito.", Severity.Success);
            await CargarMesas();
        }
        else
        {
            var err = await res.Content.ReadAsStringAsync();
            Snackbar.Add($"Error al crear mesa: {err}", Severity.Warning);
        }
    }

    private async Task EliminarMesa(int id)
    {
        var res = await Http.DeleteAsync($"api/Tables/{id}");
        if (res.IsSuccessStatusCode)
        {
            Snackbar.Add("Mesa eliminada", Severity.Info);
            await CargarMesas();
        }
        else
        {
            var err = await res.Content.ReadAsStringAsync();
            Snackbar.Add($"Error: {err}", Severity.Warning);
        }
    }

    private async Task VerCuenta(int tableId)
    {
        mesaSeleccionada = mesas?.FirstOrDefault(m => m.Id == tableId);
        dialogVisible = true;
        cuentaActual = null;
        medioPago = "Efectivo";
        propinaMonto = 0m;
        showSplitBill = false;
        splitResult = null;

        try
        {
            cuentaActual = await Http.GetFromJsonAsync<Order>($"api/Tables/{tableId}/order");
        }
        catch
        {
            Snackbar.Add("Error al cargar la cuenta", Severity.Error);
            dialogVisible = false;
        }
    }

    private void CerrarDialogo() => dialogVisible = false;

    private void ToggleSplitBill()
    {
        showSplitBill = !showSplitBill;
        if (showSplitBill && splitResult == null)
        {
            _ = CalcularSplitBill();
        }
    }

    private async Task CalcularSplitBill()
    {
        if (mesaSeleccionada == null) return;
        try
        {
            var req = new SplitBillRequest
            {
                Parts = splitParts,
                TipPercentage = splitTipPercent
            };
            var res = await Http.PostAsJsonAsync($"api/Tables/{mesaSeleccionada.Id}/split-bill", req);
            if (res.IsSuccessStatusCode)
            {
                splitResult = await res.Content.ReadFromJsonAsync<SplitBillResultDto>();
                if (splitResult != null && splitResult.Tip > 0)
                {
                    propinaMonto = splitResult.Tip;
                }
            }
            else
            {
                var err = await res.Content.ReadAsStringAsync();
                Snackbar.Add($"Error: {err}", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private async Task CobrarMesa()
    {
        if (mesaSeleccionada == null) return;
        _cobrando = true;
        try
        {
            var req = new { PaymentMethod = medioPago, TipAmount = propinaMonto };
            var response = await Http.PostAsJsonAsync($"api/Tables/{mesaSeleccionada.Id}/close", req);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add($"¡Mesa {mesaSeleccionada.Number} cobrada y liberada!", Severity.Success);
                dialogVisible = false;
                await CargarMesas();
            }
            else
            {
                Snackbar.Add("Error al cobrar la mesa", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _cobrando = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_hubConnection != null)
        {
            await _hubConnection.DisposeAsync();
        }
    }
}