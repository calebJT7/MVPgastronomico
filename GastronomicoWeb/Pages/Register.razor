@page "/register"
@attribute [AllowAnonymous]
@inject HttpClient Http
@inject JwtAuthenticationStateProvider AuthState
@inject SaaSStateService State
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@using System.Text.Json

<PageTitle>Registrar Negocio - Gastronómico SaaS</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="d-flex align-center justify-center py-10" Style="min-height: 85vh;">
    <MudCard Elevation="0" Class="pa-8 w-100" Style="border: 1px solid var(--saas-border); border-radius: 16px; background: var(--saas-surface); box-shadow: var(--saas-shadow-sm);">
        <div class="text-center mb-6">
            <div class="mx-auto mb-3" style="width: 48px; height: 48px; border-radius: 12px; background: var(--saas-primary); display: flex; align-items: center; justify-content: center;">
                <MudIcon Icon="@Icons.Material.Filled.Storefront" Style="color: var(--saas-primary-text); font-size: 24px;" />
            </div>
            <MudText Typo="Typo.h5" Class="font-weight-bold" Style="color: var(--saas-text-primary); letter-spacing: -0.02em;">Crear Cuenta de Negocio</MudText>
            <MudText Typo="Typo.body2" Style="color: var(--saas-text-secondary);" Class="mt-1">14 días de prueba gratuita con acceso total</MudText>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4 rounded-lg" Dense="true">@errorMessage</MudAlert>
        }

        <EditForm Model="@model" OnValidSubmit="HandleRegister">
            <DataAnnotationsValidator />

            <MudTextField @bind-Value="model.BusinessName" Label="Nombre del Local / Negocio"
                          Variant="Variant.Outlined" Required="true" RequiredError="El nombre del negocio es obligatorio"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Store" Class="mb-3" />

            <MudTextField @bind-Value="model.FullName" Label="Tu Nombre Completo" Variant="Variant.Outlined"
                          Required="true" RequiredError="Tu nombre es obligatorio"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Person" Class="mb-3" />

            <MudTextField @bind-Value="model.Email" Label="Correo Electrónico" Variant="Variant.Outlined"
                          InputType="InputType.Email" Required="true" RequiredError="El email es obligatorio"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Email" Class="mb-3" />

            <MudTextField @bind-Value="model.Password" Label="Contraseña (mínimo 8 caracteres)" Variant="Variant.Outlined"
                          InputType="@(showPassword ? InputType.Text : InputType.Password)" Required="true"
                          RequiredError="La contraseña es obligatoria"
                          Adornment="Adornment.End" AdornmentIcon="@(showPassword ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                          OnAdornmentClick="@(() => showPassword = !showPassword)" Class="mb-4" />

            <MudCheckBox @bind-Value="model.AcceptLegal" Color="Color.Primary" Class="mb-4" T="bool">
                <span style="font-size: 0.85rem; color: var(--saas-text-secondary);">
                    Acepto los <MudLink Href="/legal" Target="_blank" Style="color: var(--saas-text-primary); font-weight: 600;">Términos del Servicio</MudLink> y Privacidad.
                </span>
            </MudCheckBox>

            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                       FullWidth="true" Size="Size.Large" Class="rounded-lg py-3 font-weight-bold" Disabled="@(isSubmitting || !model.AcceptLegal)">
                @if (isSubmitting)
                {
                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                    <MudText Class="ms-2">Creando entorno...</MudText>
                }
                else
                {
                    <MudText>Registrar y Comenzar Gratis</MudText>
                }
            </MudButton>

            <div class="text-center mt-6">
                <MudText Typo="Typo.body2" Style="color: var(--saas-text-secondary);">
                    ¿Ya tenés una cuenta? <MudLink Href="/login" Style="color: var(--saas-text-primary); font-weight: 600;">Iniciá sesión</MudLink>
                </MudText>
            </div>
        </EditForm>
    </MudCard>
</MudContainer>

@code {
    private RegisterRequest model = new();
    private bool showPassword = false;
    private bool isSubmitting = false;
    private string? errorMessage;

    private async Task HandleRegister()
    {
        if (model.Password.Length < 8)
        {
            errorMessage = "La contraseña debe tener al menos 8 caracteres.";
            return;
        }

        isSubmitting = true;
        errorMessage = null;

        try
        {
            var response = await Http.PostAsJsonAsync("api/Auth/register", model);
            if (response.IsSuccessStatusCode)
            {
                var auth = await response.Content.ReadFromJsonAsync<AuthResponse>();
                if (auth != null)
                {
                    var businessJson = JsonSerializer.Serialize(auth);
                    await AuthState.MarkUserAsAuthenticatedAsync(auth.Token, businessJson);
                    State.SetAuthInfo(auth);
                    Snackbar.Add("¡Negocio registrado con éxito! Bienvenido al sistema.", Severity.Success);
                    Nav.NavigateTo("/onboarding");
                }
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                errorMessage = string.IsNullOrWhiteSpace(err) ? "No se pudo registrar la cuenta." : err;
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Error de conexión con el servidor: " + ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
